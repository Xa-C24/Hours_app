<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f2937" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Hours" />
    <title>Suivi des heures</title>
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/icon-512.png" />
    <link rel="manifest" href="/manifest.json" />
    <script type="module" src="/vendor/emoji-picker-element/index.js"></script>
    <script>
      (() => {
        const themeKey = "hours_theme";
        const styleKey = "hours_style";
        const allowedThemes = ["light", "dark", "deep-ocean-blue", "light-blue", "orange-sunset", "forest-green", "light-green", "robot"];
        const allowedStyles = ["premium", "robot", "retro"];
        try {
          const storedTheme = localStorage.getItem(themeKey) || "light";
          const theme = storedTheme === "futuristic-robot" ? "robot" : storedTheme;
          const storedStyle = localStorage.getItem(styleKey) || "";
          const style = allowedStyles.includes(storedStyle) ? storedStyle : theme === "robot" ? "robot" : "premium";
          document.documentElement.setAttribute("data-theme", allowedThemes.includes(theme) ? theme : "light");
          document.documentElement.setAttribute("data-style", style);
        } catch (error) {
          document.documentElement.setAttribute("data-theme", "light");
          document.documentElement.setAttribute("data-style", "premium");
        }
      })();
    </script>
    <link rel="stylesheet" href="/style.css" />
    <style>
      .client-switch-form {
        display: flex;
        align-items: end;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      .client-switch-form .theme-picker {
        min-width: 230px;
      }

      .client-add-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 3rem;
        min-height: 3rem;
        padding-inline: 0.95rem;
      }

      .client-view-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 3rem;
        min-height: 3rem;
        padding-inline: 0.95rem;
      }

      .client-empty-card {
        margin-top: 2rem;
        padding: 1.4rem;
      }

      .client-empty-card p {
        margin: 0.5rem 0 0;
      }

      .client-modal[hidden] {
        display: none;
      }

      .client-modal {
        position: fixed;
        inset: 0;
        z-index: 40;
        display: grid;
        place-items: center;
        padding: 1rem;
      }

      .client-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(8, 15, 27, 0.62);
        backdrop-filter: blur(8px);
      }

      .client-modal-dialog {
        position: relative;
        z-index: 1;
        width: min(100%, 720px);
        max-height: calc(100vh - 2rem);
        overflow: auto;
        padding: 1.2rem;
      }

      .client-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .client-modal-header h2 {
        margin: 0;
      }

      .client-modal-close {
        width: 2.2rem;
        min-width: 2.2rem;
        height: 2.2rem;
        padding: 0;
      }

      .client-modal-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
      }

      .client-modal-grid .field-full {
        grid-column: 1 / -1;
      }

      .confirm-replace-copy {
        margin: 0 0 1rem;
        color: var(--text-secondary);
      }

      .confirm-replace-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .client-info-list {
        display: grid;
        gap: 0.8rem;
      }

      .client-info-item {
        display: grid;
        gap: 0.18rem;
        padding: 0.9rem 1rem;
        border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
        border-radius: 14px;
        background: color-mix(in srgb, var(--card-bg) 92%, transparent);
      }

      .client-info-item strong {
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .client-info-item span {
        word-break: break-word;
      }

      .archived-clients-card {
        margin-top: 2rem;
        padding: 1.2rem;
      }

      .archived-clients-card.is-collapsed .card-toggle-icon {
        transform: rotate(-90deg);
      }

      .archived-clients-panel[hidden],
      .archived-history[hidden] {
        display: none;
      }

      .archived-clients-toolbar {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin: 1rem 0 1.15rem;
      }

      .archived-clients-toolbar .field {
        display: flex;
        flex: 1 1 22rem;
        max-width: 34rem;
        flex-direction: column;
        gap: 0.42rem;
      }

      .archived-clients-toolbar label {
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .archived-clients-toolbar input {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: var(--radius-control);
        background: var(--input-bg);
        color: var(--text);
        font: inherit;
        min-height: 3rem;
        padding: 0.8rem 0.95rem;
        outline: none;
        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease;
      }

      .archived-clients-toolbar input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px var(--focus-ring);
      }

      .archived-clients-list {
        display: grid;
        gap: 0.85rem;
      }

      .archived-client-item {
        border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
        border-radius: var(--radius-control);
        padding: 1rem 1.05rem;
        background: color-mix(in srgb, var(--card-bg) 94%, transparent);
      }

      .archived-client-summary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 1rem;
      }

      .archived-client-name {
        display: block;
        font-weight: 800;
        word-break: break-word;
      }

      .archived-client-meta {
        display: block;
        margin-top: 0.22rem;
        color: var(--muted);
        font-size: 0.88rem;
      }

      .archived-client-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.45rem;
        flex-wrap: wrap;
      }

      .archived-client-actions .button-link,
      .archived-client-actions button {
        min-width: 8.5rem;
        white-space: nowrap;
      }

      .archived-client-actions form {
        margin: 0;
        display: flex;
      }

      .archived-delete-button {
        min-width: 2.75rem !important;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .archived-delete-button svg {
        width: 1.05rem;
        height: 1.05rem;
      }

      .archived-history {
        margin-top: 0.9rem;
      }

      .pay-period-card.is-collapsed .card-toggle-icon {
        transform: rotate(-90deg);
      }

      .pay-period-card .month-header {
        display: grid;
        grid-template-columns: minmax(0, auto) minmax(18rem, 1fr) auto;
        align-items: end;
      }

      .pay-period-card .month-tools {
        justify-content: end;
      }

      .pay-period-panel[hidden] {
        display: none;
      }

      .app-footer {
        margin: 2rem 0 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
        border-radius: 18px;
        background: color-mix(in srgb, var(--card-bg) 86%, transparent);
        color: var(--muted);
      }

      .app-footer-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.85rem;
        flex-wrap: wrap;
      }

      .app-footer p {
        margin: 0;
      }

      .app-footer a {
        color: var(--link);
        font-weight: 700;
        text-decoration: none;
      }

      .app-footer a:hover {
        color: var(--link-hover);
        text-decoration: underline;
      }

      @media (max-width: 700px) {
        .client-switch-form {
          width: 100%;
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto auto;
          align-items: end;
          gap: 0.55rem;
        }

        .client-switch-form .theme-picker {
          min-width: 0;
        }

        .client-view-button,
        .client-add-button {
          width: 2.9rem;
          min-width: 2.9rem;
          min-height: 2.9rem;
          padding-inline: 0;
        }

        .client-switch-form > * {
          min-width: 0;
        }

        .client-modal {
          align-items: end;
          padding:
            max(0.75rem, env(safe-area-inset-top))
            max(0.7rem, env(safe-area-inset-right))
            max(0.75rem, env(safe-area-inset-bottom))
            max(0.7rem, env(safe-area-inset-left));
        }

        .client-modal-dialog {
          width: 100%;
          max-height: min(84vh, calc(100vh - 1.5rem));
          padding: 1rem 0.9rem;
          border-radius: 18px;
        }

        .client-modal-header {
          position: sticky;
          top: 0;
          z-index: 2;
          padding-bottom: 0.4rem;
          background: inherit;
        }

        .client-modal-grid {
          grid-template-columns: 1fr;
        }

        .archived-clients-toolbar {
          display: block;
        }

        .archived-clients-toolbar .field {
          max-width: none;
        }

        .archived-client-summary {
          grid-template-columns: 1fr;
          align-items: stretch;
        }

        .archived-client-actions {
          justify-content: flex-start;
        }

        .archived-client-actions .button-link,
        .archived-client-actions form,
        .archived-client-actions button {
          width: 100%;
          min-width: 0;
        }

        .pay-period-card .month-header {
          grid-template-columns: minmax(0, 1fr) auto;
        }

        .pay-period-card .month-tools {
          grid-column: 1 / -1;
          order: 3;
        }

        .app-footer-content {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (max-width: 480px) {
        .client-switch-form {
          grid-template-columns: 1fr;
        }

        .client-view-button,
        .client-add-button {
          width: 100%;
          min-width: 0;
        }

        .client-modal-dialog {
          max-height: min(88vh, calc(100vh - 1rem));
          padding: 0.92rem 0.82rem;
        }

        .client-modal-header h2 {
          font-size: 1.35rem;
        }

        .client-info-item {
          padding: 0.78rem 0.82rem;
        }
      }
    </style>
  </head>
  <body class="home-premium-page">
    <% const _isEditing = typeof isEditing !== "undefined" ? isEditing : false; %>
    <% const _editingWorkDate = typeof editingWorkDate === "string" ? editingWorkDate : ""; %>
    <% const _selectedClientId = selectedClient ? selectedClient.id : ""; %>
    <main class="container">
      <div class="between-sections-spacer" aria-hidden="true"></div>
      <header class="page-header page-header-premium">
        <div class="page-header-copy">
          <h1>Suivi mensuel des heures de travail</h1>
        </div>
        <div class="header-actions">
          <form action="/" method="get" class="client-switch-form">
            <input type="hidden" name="month" value="<%= selectedMonth %>" />
            <div class="theme-picker">
              <label for="clientSelectApp">Client</label>
              <select id="clientSelectApp" name="clientId" onchange="this.form.submit()">
                <% if (clients.length === 0) { %>
                <option value="">Aucun client</option>
                <% } %>
                <% clients.forEach((client) => { %>
                <option value="<%= client.id %>" <%= selectedClient && selectedClient.id === client.id ? "selected" : "" %>>
                  <%= client.company_name %>
                </option>
                <% }); %>
              </select>
            </div>
            <button
              type="button"
              class="client-view-button secondary"
              data-open-client-info-modal
              data-ripple
              aria-label="Voir les informations du client"
              title="Afficher détail"
              <%= selectedClient ? "" : "disabled" %>
            >
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="3"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                />
              </svg>
            </button>
            <button
              type="button"
              class="client-add-button"
              data-open-client-modal
              data-ripple
              aria-label="Ajouter un client"
              title="Ajouter un client"
            >+</button>
          </form>
          <div class="theme-picker">
            <label for="themeSelectApp">Theme</label>
            <select id="themeSelectApp" data-theme-selector>
              <option value="light">Ivoire</option>
              <option value="dark">Nuit graphite</option>
              <option value="deep-ocean-blue">Bleu minuit</option>
              <option value="light-blue">Brume bleue</option>
              <option value="orange-sunset">Sable cuivre</option>
              <option value="forest-green">Sauge profonde</option>
              <option value="light-green">Celadon</option>
            </select>
          </div>
          <div class="theme-picker">
            <label for="styleSelectApp">Style</label>
            <select id="styleSelectApp" data-style-selector>
              <option value="premium">Premium</option>
              <option value="robot">Robot</option>
              <option value="retro">SEGA</option>
            </select>
          </div>
          <form action="/logout" method="post" class="logout-form">
            <% if (authUser) { %>
            <span class="user-chip"><%= authUser %></span>
            <% } %>
            <button type="submit" class="secondary" data-ripple>Déconnexion</button>
          </form>
        </div>
      </header>

      <% if (clientError) { %>
      <p class="alert"><%= clientError %></p>
      <% } %>

      <% if (error && !showReplaceConfirmation) { %>
      <p class="alert"><%= error %></p>
      <% } %>

      <% if (selectedClient) { %>
      <section class="premium-summary-grid" aria-label="Resume de la periode">
        <article class="premium-mini-card">
          <span class="premium-mini-label">Client</span>
          <strong class="premium-mini-value"><%= selectedClient.company_name %></strong>
          <span class="premium-mini-meta"><%= selectedClient.contact_name || "Client actif" %></span>
        </article>
        <article class="premium-mini-card">
          <span class="premium-mini-label">Periode</span>
          <strong class="premium-mini-value"><%= payPeriodLabel || selectedMonth %></strong>
          <span class="premium-mini-meta">Vue active</span>
        </article>
        <article class="premium-mini-card">
          <span class="premium-mini-label">Jours travailles</span>
          <strong class="premium-mini-value"><%= workedDayCount %></strong>
          <span class="premium-mini-meta">Sur la période</span>
        </article>
        <article class="premium-mini-card">
          <span class="premium-mini-label">Total cumule</span>
          <strong class="premium-mini-value"><%= totalHHMM %></strong>
          <span class="premium-mini-meta">Total heures sur la période</span>
        </article>
      </section>

      <div class="between-sections-spacer" aria-hidden="true"></div>

      <section class="card entry-card premium-surface" data-entry-card>
        <div class="entry-card-top">
          <div class="section-heading">
            <p class="section-eyebrow">Saisie</p>
            <h2><%= _isEditing ? "Modifier une journee" : "Saisir une journée" %></h2>
          </div>
          <button
            type="button"
            class="card-toggle"
            data-entry-toggle
            data-ripple
            aria-expanded="true"
            aria-controls="entryFormPanel"
            title="Replier ou ouvrir la saisie"
          >
            <span class="card-toggle-icon" aria-hidden="true">▾</span>
          </button>
        </div>
		        <form
              action="/entries"
              method="post"
              class="entry-form"
              id="entryFormPanel"
              data-entry-form
              data-default-day-type="<%= defaultEntryFormData.dayType %>"
              data-default-arrival-time="<%= defaultEntryFormData.arrivalTime %>"
              data-default-departure-time="<%= defaultEntryFormData.departureTime %>"
              data-default-lunch-break-minutes="<%= defaultEntryFormData.lunchBreakMinutes %>"
              data-default-comment-text="<%= defaultEntryFormData.commentText || "" %>"
            >
		          <input type="hidden" name="selectedMonth" value="<%= selectedMonth %>" />
		          <input type="hidden" name="clientId" value="<%= _selectedClientId %>" />
		          <input type="hidden" name="originalWorkDate" value="<%= formData.originalWorkDate || '' %>" />
		          <input type="hidden" name="confirmReplace" value="" data-confirm-replace-input />

	          <div class="field">
	            <label for="date">Date</label>
	            <input id="date" name="date" type="date" required value="<%= formData.date %>" />
	          </div>

            <p class="entry-load-status" data-entry-load-status hidden aria-live="polite"></p>

          <div class="field">
            <label for="dayType">Type de journee</label>
            <select id="dayType" name="dayType" required data-day-type-select>
              <% dayTypeOptions.forEach((option) => { %>
              <option value="<%= option.value %>" <%= formData.dayType === option.value ? "selected" : "" %>>
                <%= option.label %>
              </option>
              <% }); %>
            </select>
          </div>

          <div class="field">
            <label for="arrivalTime">Heure d'arrivee</label>
            <input
              id="arrivalTime"
              name="arrivalTime"
              type="time"
              required
              value="<%= formData.arrivalTime %>"
              data-worked-day-field
            />
          </div>

          <div class="field">
            <label for="departureTime">Heure de depart</label>
            <input
              id="departureTime"
              name="departureTime"
              type="time"
              required
              value="<%= formData.departureTime %>"
              data-worked-day-field
            />
          </div>

          <div class="field">
            <label for="lunchBreakMinutes">Pause dejeuner (minutes)</label>
            <input
              id="lunchBreakMinutes"
              name="lunchBreakMinutes"
              type="number"
              min="0"
              required
              value="<%= formData.lunchBreakMinutes %>"
              data-worked-day-field
            />
          </div>

          <div class="field field-comment">
            <label for="commentText">Commentaire</label>
            <div class="comment-toolbar">
              <details class="comment-emoji-picker">
                <summary class="comment-emoji-summary">
                  <span>🙂</span>
                  <span class="comment-emoji-caret" aria-hidden="true">▾</span>
                </summary>
                <div class="comment-emoji-popover">
                  <emoji-picker class="comment-emoji-component" locale="fr"></emoji-picker>
                </div>
              </details>
            </div>
            <textarea
              id="commentText"
              name="commentText"
              rows="3"
              maxlength="1000"
              placeholder="Ex: reunion client, deplacement, taches importantes..."
              data-comment-target
            ><%= formData.commentText || "" %></textarea>
          </div>

	          <div class="form-actions">
	            <button type="submit" data-ripple><%= _isEditing ? "Mettre a jour" : "Enregistrer" %></button>
	            <% if (_isEditing) { %>
            <a
              class="button-link button-neutral"
              href="/?month=<%= encodeURIComponent(selectedMonth) %>&clientId=<%= encodeURIComponent(_selectedClientId) %>"
              data-ripple
            >
              Annuler
            </a>
            <% } %>
          </div>
        </form>
      </section>

      <div class="between-sections-spacer" aria-hidden="true"></div>

      <section class="card premium-surface premium-surface-wide pay-period-card" data-pay-period-card>
        <div class="month-header">
          <div class="month-header-copy">
            <h2>Période de paie</h2>
            <% if (payPeriodLabel) { %>
            <p class="month-period-label"><%= payPeriodLabel %></p>
            <% } %>
          </div>

          <div class="month-tools">
            <form action="/" method="get" class="month-form">
              <input type="hidden" name="clientId" value="<%= _selectedClientId %>" />
              <div class="month-form-row">
                <label for="month">Choisir un mois</label>
                <div class="month-form-controls">
                  <input id="month" name="month" type="month" required value="<%= selectedMonth %>" />
                  <button type="submit" data-ripple>Afficher</button>
                  <a
                    class="button-link"
                    href="/export.csv?month=<%= encodeURIComponent(selectedMonth) %>&clientId=<%= encodeURIComponent(_selectedClientId) %>"
                    data-ripple
                  >
                    Export CSV
                  </a>
                </div>
              </div>
            </form>
          </div>
          <button
            type="button"
            class="card-toggle"
            data-pay-period-toggle
            data-ripple
            aria-expanded="true"
            aria-controls="payPeriodPanel"
            title="Replier ou ouvrir la période"
          >
            <span class="card-toggle-icon" aria-hidden="true">▾</span>
          </button>
        </div>

        <div id="payPeriodPanel" class="pay-period-panel" data-pay-period-panel>
          <div class="day-filter-bar" data-day-filter-bar>
            <% dayTypeFilters.forEach((filter, index) => { %>
            <button
              type="button"
              class="day-filter-chip <%= index === 0 ? 'is-active' : '' %>"
              data-day-filter="<%= filter.value %>"
              data-ripple
              aria-pressed="<%= index === 0 ? 'true' : 'false' %>"
              title="Période: <%= filter.count %> | Année affichée: <%= filter.yearCount %>"
            >
              <span><%= filter.label %></span>
              <span class="day-filter-counts">
                <span class="day-filter-count" title="Période">
                  <span class="day-filter-count-label" title="Mois" aria-label="Mois">M</span>
                  <span><%= filter.count %></span>
                </span>
                <span class="day-filter-count day-filter-count-year" title="Année affichée">
                  <span class="day-filter-count-label" title="Année" aria-label="Année">A</span>
                  <span><%= filter.yearCount %></span>
                </span>
              </span>
            </button>
            <% }); %>
          </div>

          <div class="table-wrapper table-wrapper-main">
            <table class="hours-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Arrivee</th>
                <th>Depart</th>
                <th>Pause (min)</th>
                <th>Heures du jour</th>
                <th class="overtime-col">Heures sup</th>
                <th class="recovered-col">Heures recup</th>
                <th>Etat</th>
                <th class="comment-col">Commentaire</th>
                <th class="action-col">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (displayEntries.length === 0) { %>
              <tr>
                <td colspan="11" class="empty">Aucune journée enregistrée pour ce client sur cette période.</td>
