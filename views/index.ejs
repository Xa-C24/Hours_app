                  <%= entry.work_date_display || (entry.work_date ? new Date(`${entry.work_date}T00:00:00`).toLocaleDateString("fr-FR", { weekday: "long", day: "2-digit", month: "long", year: "numeric" }) : "") %>
                </td>
                <td data-label="Type"><%= entry.day_type_display %></td>
                <td data-label="Arrivee"><%= entry.arrival_time_display %></td>
                <td data-label="Depart"><%= entry.departure_time_display %></td>
                <td data-label="Pause (min)"><%= entry.lunch_break_minutes_display %></td>
                <td data-label="Heures du jour"><%= entry.worked_hhmm %></td>
                <td class="overtime-col" data-label="Heures sup"><%= entry.overtime_hhmm %></td>
