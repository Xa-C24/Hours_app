              <input id="clientContactName" name="contact_name" type="text" value="<%= _clientFormData.contact_name || '' %>" />
            </div>
            <div class="field">
              <label for="clientEmail">Email</label>
              <input id="clientEmail" name="email" type="email" value="<%= _clientFormData.email || '' %>" />
            </div>
            <div class="field">
              <label for="clientPhone">Téléphone</label>
              <input id="clientPhone" name="phone" type="text" value="<%= _clientFormData.phone || '' %>" />
            </div>
            <div class="field field-full">
              <label for="clientAddress">Adresse</label>
              <textarea id="clientAddress" name="address" rows="2"><%= _clientFormData.address || '' %></textarea>
            </div>
            <div class="field field-full">
              <label for="clientNotes">Notes</label>
              <textarea id="clientNotes" name="notes" rows="4"><%= _clientFormData.notes || '' %></textarea>
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" data-ripple>Créer le client</button>
            <button type="button" class="button-link button-neutral" data-close-client-modal data-ripple>Annuler</button>
          </div>
        </form>
      </section>
    </div>

    <div class="client-modal" data-client-info-modal <%= _showClientInfoModal ? "" : "hidden" %>>
      <div class="client-modal-backdrop" data-close-client-info-modal></div>
      <section class="card premium-surface client-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="clientInfoModalTitle">
        <div class="client-modal-header">
          <div class="section-heading">
            <p class="section-eyebrow">Informations client</p>
            <h2 id="clientInfoModalTitle"><%= selectedClient ? selectedClient.company_name : "Client" %></h2>
          </div>
          <button type="button" class="client-modal-close secondary" data-close-client-info-modal aria-label="Fermer">×</button>
        </div>
        <% if (selectedClient) { %>
        <form action="/clients/<%= selectedClient.id %>/update" method="post" class="login-form">
          <input type="hidden" name="selectedMonth" value="<%= selectedMonth %>" />
          <div class="client-modal-grid">
            <div class="field">
              <label for="clientInfoCompanyName">Entreprise</label>
              <input id="clientInfoCompanyName" name="company_name" type="text" required value="<%= selectedClient.company_name || '' %>" />
            </div>
            <div class="field">
              <label for="clientInfoContactName">Contact</label>
              <input id="clientInfoContactName" name="contact_name" type="text" value="<%= selectedClient.contact_name || '' %>" />
            </div>
            <div class="field">
              <label for="clientInfoEmail">Email</label>
              <input id="clientInfoEmail" name="email" type="email" value="<%= selectedClient.email || '' %>" />
            </div>
            <div class="field">
              <label for="clientInfoPhone">Téléphone</label>
              <input id="clientInfoPhone" name="phone" type="text" value="<%= selectedClient.phone || '' %>" />
            </div>
            <div class="field field-full">
              <label for="clientInfoAddress">Adresse</label>
              <textarea id="clientInfoAddress" name="address" rows="2"><%= selectedClient.address || '' %></textarea>
            </div>
            <div class="field field-full">
              <label for="clientInfoNotes">Notes</label>
              <textarea id="clientInfoNotes" name="notes" rows="4"><%= selectedClient.notes || '' %></textarea>
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" data-ripple>Enregistrer</button>
            <button type="button" class="button-link button-neutral" data-close-client-info-modal data-ripple>Fermer</button>
          </div>
        </form>
        <div class="form-actions">
          <form
            action="/clients/<%= selectedClient.id %>/archive"
            method="post"
            onsubmit="return confirm('Archiver ce client ? Il ne sera plus affiche dans la liste active.');"
          >
            <input type="hidden" name="selectedMonth" value="<%= selectedMonth %>" />
            <button type="submit" class="secondary" data-ripple>Archiver ce client</button>
          </form>
          <form
            action="/clients/<%= selectedClient.id %>/delete"
            method="post"
            onsubmit="return confirm('Supprimer ce client et toutes ses données ?');"
          >
            <input type="hidden" name="selectedMonth" value="<%= selectedMonth %>" />
            <button type="submit" class="danger" data-ripple>Supprimer ce client</button>
          </form>
        </div>
        <% } else { %>
        <p>Aucun client sélectionné.</p>
        <% } %>
      </section>
    </div>

    <div class="client-modal" data-confirm-replace-modal <%= _showReplaceConfirmation ? "" : "hidden" %>>
      <div class="client-modal-backdrop" data-close-confirm-replace-modal></div>
      <section class="card premium-surface client-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="confirmReplaceTitle">
        <div class="client-modal-header">
          <div class="section-heading">
            <p class="section-eyebrow">Conflit de date</p>
            <h2 id="confirmReplaceTitle">Remplacer l'entrée existante ?</h2>
          </div>
          <button type="button" class="client-modal-close secondary" data-close-confirm-replace-modal aria-label="Fermer">×</button>
        </div>
        <p class="confirm-replace-copy">
          Une entrée existe déjà à cette date. Voulez-vous valider la modification et remplacer l'entrée existante ?
        </p>
        <div class="confirm-replace-actions">
          <button type="button" class="button-link button-neutral" data-close-confirm-replace-modal data-ripple>Non</button>
          <button type="button" class="danger" data-confirm-replace-submit data-ripple>Valider la modification</button>
        </div>
      </section>
    </div>

	    <script src="/theme.js"></script>
	    <script>
	      (() => {
	        const csrfToken = <%- JSON.stringify(_csrfToken) %>;
	        if (!csrfToken) {
	          return;
	        }
	        document.querySelectorAll('form[method="post"]').forEach((form) => {
	          let csrfInput = form.querySelector('input[name="_csrf"]');
	          if (!csrfInput) {
	            csrfInput = document.createElement("input");
	            csrfInput.type = "hidden";
	            csrfInput.name = "_csrf";
	            form.prepend(csrfInput);
	          }
	          csrfInput.value = csrfToken;
	        });
	      })();
      (() => {
        const commentField = document.querySelector("[data-comment-target]");
        const emojiPicker = document.querySelector(".comment-emoji-component");
        const emojiPickerDetails = document.querySelector(".comment-emoji-picker");

        if (!commentField || !emojiPicker || !emojiPickerDetails) {
          return;
        }

        const insertEmoji = (emoji) => {
          const start = commentField.selectionStart ?? commentField.value.length;
          const end = commentField.selectionEnd ?? commentField.value.length;
          const prefix = start > 0 && !/\s$/.test(commentField.value.slice(0, start)) ? " " : "";
          const suffix = end < commentField.value.length && !/^\s/.test(commentField.value.slice(end)) ? " " : "";
          const insertedText = `${prefix}${emoji}${suffix}`;

          commentField.setRangeText(insertedText, start, end, "end");
          commentField.focus();
        };

        emojiPicker.addEventListener("emoji-click", (event) => {
          const emoji = event.detail && typeof event.detail.unicode === "string"
            ? event.detail.unicode
            : "";
          if (!emoji) {
            return;
          }
          insertEmoji(emoji);
          emojiPickerDetails.open = false;
        });
      })();

      (() => {
        const dayTypeSelect = document.querySelector("[data-day-type-select]");
        const workedDayFields = [...document.querySelectorAll("[data-worked-day-field]")];
        const workedDayTypes = new Set(["office", "remote"]);

        if (!dayTypeSelect || workedDayFields.length === 0) {
          return;
        }

        const syncWorkedDayFields = () => {
          const isWorkedDay = workedDayTypes.has(dayTypeSelect.value);
          workedDayFields.forEach((field) => {
            field.disabled = !isWorkedDay;
            field.required = isWorkedDay;
          });
        };

        dayTypeSelect.addEventListener("change", syncWorkedDayFields);
        syncWorkedDayFields();
      })();

	      (() => {
	        const entryForm = document.querySelector("[data-entry-form]");
	        const clientIdInput = entryForm ? entryForm.querySelector('input[name="clientId"]') : null;
	        const originalWorkDateInput = entryForm ? entryForm.querySelector('input[name="originalWorkDate"]') : null;
	        const dateInput = entryForm ? entryForm.querySelector("#date") : null;
	        const dayTypeSelect = entryForm ? entryForm.querySelector("#dayType") : null;
	        const arrivalInput = entryForm ? entryForm.querySelector("#arrivalTime") : null;
	        const departureInput = entryForm ? entryForm.querySelector("#departureTime") : null;
	        const lunchInput = entryForm ? entryForm.querySelector("#lunchBreakMinutes") : null;
	        const commentInput = entryForm ? entryForm.querySelector("#commentText") : null;
	        const statusMessage = entryForm ? entryForm.querySelector("[data-entry-load-status]") : null;
          const stateBadge = entryForm ? entryForm.querySelector("[data-entry-state-badge]") : null;
          const summaryValue = entryForm ? entryForm.querySelector("[data-entry-summary-value]") : null;
          const summaryFeedback = entryForm ? entryForm.querySelector("[data-entry-summary-feedback]") : null;
          const submitButton = entryForm ? entryForm.querySelector("[data-entry-submit-button]") : null;
	        let activeController = null;

	        if (
	          !entryForm ||
	          !clientIdInput ||
	          !originalWorkDateInput ||
	          !dateInput ||
	          !dayTypeSelect ||
	          !arrivalInput ||
	          !departureInput ||
	          !lunchInput ||
	          !commentInput ||
	          !statusMessage ||
            !stateBadge ||
            !summaryValue ||
            !summaryFeedback ||
            !submitButton
	        ) {
	          return;
	        }

          const SAVE_FLASH_STORAGE_KEY = "hours_entry_save_flash";
          const SUMMARY_TARGET_MINUTES = 7 * 60;
          const workedDayTypes = new Set(["office", "remote"]);
          const defaultFormValues = {
            workDate: "",
            isExisting: false,
            dayType: entryForm.dataset.defaultDayType || "office",
            arrivalTime: entryForm.dataset.defaultArrivalTime || "",
            departureTime: entryForm.dataset.defaultDepartureTime || "",
            lunchBreakMinutes: entryForm.dataset.defaultLunchBreakMinutes || "",
            commentText: entryForm.dataset.defaultCommentText || "",
          };
          const entryCache = new Map();
	          const state = {
	            selectedDate: dateInput.value || "",
	            currentEntry: null,
	            statusText: "",
	            statusVariant: "",
              badgeState: "is-empty",
	            lastResolvedKey: "",
              isLoading: false,
              isDirty: false,
              isSaving: false,
              showSavedFlash: false,
	          };

          const formatMinutesToHHMM = (minutes) => {
            const safeMinutes = Math.max(0, Number(minutes) || 0);
            return `${String(Math.floor(safeMinutes / 60)).padStart(2, "0")}:${String(safeMinutes % 60).padStart(2, "0")}`;
          };

          const formatDurationLabel = (minutes) => {
            const safeMinutes = Math.max(0, Number(minutes) || 0);
            const hours = Math.floor(safeMinutes / 60);
            const remainingMinutes = safeMinutes % 60;
            return `${hours} h ${String(remainingMinutes).padStart(2, "0")}`;
          };

	          const cloneEntry = (entry) => ({
	            workDate: entry && entry.workDate ? entry.workDate : state.selectedDate,
	            isExisting: Boolean(entry && entry.isExisting),
	            dayType: entry && entry.dayType ? entry.dayType : defaultFormValues.dayType,
	            arrivalTime: entry && typeof entry.arrivalTime === "string" ? entry.arrivalTime : defaultFormValues.arrivalTime,
            departureTime:
              entry && typeof entry.departureTime === "string" ? entry.departureTime : defaultFormValues.departureTime,
            lunchBreakMinutes:
              entry && typeof entry.lunchBreakMinutes === "string"
                ? entry.lunchBreakMinutes
                : String(
	                    entry && typeof entry.lunchBreakMinutes === "number"
	                      ? entry.lunchBreakMinutes
	                      : defaultFormValues.lunchBreakMinutes
	                  ),
	            commentText: entry && typeof entry.commentText === "string" ? entry.commentText : defaultFormValues.commentText,
	          });

          const entriesMatch = (leftEntry, rightEntry) => {
            const left = cloneEntry(leftEntry);
            const right = cloneEntry(rightEntry);
            return (
              left.workDate === right.workDate &&
              left.dayType === right.dayType &&
              left.arrivalTime === right.arrivalTime &&
              left.departureTime === right.departureTime &&
              left.lunchBreakMinutes === right.lunchBreakMinutes &&
              left.commentText === right.commentText &&
              left.isExisting === right.isExisting
            );
          };

          const getDefaultEntryForSelectedDate = () =>
            cloneEntry({
              ...defaultFormValues,
              workDate: state.selectedDate || dateInput.value || "",
            });

          const getBaselineEntry = () =>
            state.currentEntry && state.currentEntry.isExisting
              ? cloneEntry(state.currentEntry)
              : getDefaultEntryForSelectedDate();

          const updateDirtyState = () => {
            state.isDirty = !entriesMatch(readEntryFromForm(), getBaselineEntry());
          };

          const getBadgeConfig = () => {
            if (state.isLoading || state.isSaving) {
              return {
                className: "is-loading",
                text: "🔄 Chargement",
              };
            }

            if (state.isDirty) {
              return {
                className: "is-dirty",
                text: "🟠 Modifications non enregistrées",
              };
            }

            if (state.currentEntry && state.currentEntry.isExisting) {
              return {
                className: "is-success",
                text: "🟢 Journée enregistrée",
              };
            }

            return {
              className: "is-empty",
              text: "⚪ Nouvelle journée",
            };
          };

          const renderBadge = () => {
            const badge = getBadgeConfig();
            stateBadge.textContent = badge.text;
            stateBadge.classList.remove("is-success", "is-empty", "is-dirty", "is-loading");
            stateBadge.classList.add(badge.className);
          };

	          const renderStatus = () => {
	            statusMessage.textContent = state.statusText || "";
	            statusMessage.hidden = !state.statusText;
	            statusMessage.classList.remove("is-success", "is-empty", "is-dirty", "is-loading");
	            if (state.statusVariant) {
	              statusMessage.classList.add(state.statusVariant);
	            }
	          };

          const renderSummary = () => {
            const currentEntry = readEntryFromForm();
            const isWorkedDay = workedDayTypes.has(currentEntry.dayType);

            if (!isWorkedDay) {
              summaryValue.textContent = "00:00";
              summaryFeedback.textContent = "Journee sans objectif horaire";
              return;
            }

            if (!currentEntry.arrivalTime || !currentEntry.departureTime) {
              summaryValue.textContent = "--:--";
              summaryFeedback.textContent = "Renseignez les horaires pour voir le temps prevu";
              return;
            }

            const arrivalParts = currentEntry.arrivalTime.split(":").map(Number);
            const departureParts = currentEntry.departureTime.split(":").map(Number);
            if (arrivalParts.length !== 2 || departureParts.length !== 2) {
              summaryValue.textContent = "--:--";
              summaryFeedback.textContent = "Renseignez les horaires pour voir le temps prevu";
              return;
            }

            const arrivalMinutes = arrivalParts[0] * 60 + arrivalParts[1];
            const departureMinutes = departureParts[0] * 60 + departureParts[1];
            const breakMinutes = Math.max(0, Number(currentEntry.lunchBreakMinutes) || 0);
            const plannedMinutes = Math.max(0, departureMinutes - arrivalMinutes - breakMinutes);

            summaryValue.textContent = formatMinutesToHHMM(plannedMinutes);
            if (departureMinutes <= arrivalMinutes) {
              summaryFeedback.textContent = "Verifiez l'ordre arrivee / depart";
              return;
            }

            if (plannedMinutes >= SUMMARY_TARGET_MINUTES) {
              summaryFeedback.textContent = "Objectif atteint";
              return;
            }

            summaryFeedback.textContent = `Il reste ${formatDurationLabel(SUMMARY_TARGET_MINUTES - plannedMinutes)}`;
          };

          const updateSubmitButton = (label, disabled) => {
            submitButton.textContent = label;
            submitButton.disabled = Boolean(disabled);
            submitButton.classList.toggle("is-saving", Boolean(disabled));
          };

          const autosizeComment = () => {
            commentInput.style.height = "auto";
            const minHeight = 72;
            commentInput.style.height = `${Math.max(minHeight, commentInput.scrollHeight)}px`;
          };

	          const renderEntry = () => {
	            const entry = state.currentEntry ? cloneEntry(state.currentEntry) : cloneEntry(defaultFormValues);
	            originalWorkDateInput.value =
	              state.currentEntry && state.currentEntry.isExisting && state.currentEntry.workDate
	                ? state.currentEntry.workDate
                : "";
            dayTypeSelect.value = entry.dayType;
	            arrivalInput.value = entry.arrivalTime;
	            departureInput.value = entry.departureTime;
	            lunchInput.value = entry.lunchBreakMinutes;
	            commentInput.value = entry.commentText;
	            dayTypeSelect.dispatchEvent(new Event("change", { bubbles: true }));
              autosizeComment();
              updateDirtyState();
              renderSummary();
              renderBadge();
	          };

	          const setFormState = ({ entry, statusText, statusVariant, resolvedKey }) => {
	            state.currentEntry = entry ? cloneEntry(entry) : null;
	            state.statusText = statusText || "";
	            state.statusVariant = statusVariant || "";
	            state.lastResolvedKey = resolvedKey || "";
              state.isLoading = false;
              state.isSaving = false;
	            renderEntry();
	            renderStatus();
	          };

          const getRequestKey = (clientId, selectedDate) => `${clientId}:${selectedDate}`;

          const persistEntryInCache = (entry) => {
            const clientId = clientIdInput.value;
            if (!clientId || !entry || !entry.workDate) {
              return;
            }

            entryCache.set(getRequestKey(clientId, entry.workDate), cloneEntry(entry));
          };

	          const readEntryFromForm = () => ({
	            workDate: dateInput.value || "",
	            isExisting: Boolean(originalWorkDateInput.value),
	            dayType: dayTypeSelect.value || defaultFormValues.dayType,
	            arrivalTime: arrivalInput.value || defaultFormValues.arrivalTime,
            departureTime: departureInput.value || defaultFormValues.departureTime,
            lunchBreakMinutes: lunchInput.value || String(defaultFormValues.lunchBreakMinutes),
	            commentText: commentInput.value || "",
	          });

          const markUnsavedIfNeeded = () => {
            updateDirtyState();
            if (state.isLoading || state.isSaving) {
              renderBadge();
              return;
            }

            if (state.isDirty) {
              state.statusText = "Modifications locales non enregistrees";
              state.statusVariant = "is-dirty";
            } else if (state.currentEntry && state.currentEntry.isExisting) {
              state.statusText = "Entrée existante pour ce jour";
              state.statusVariant = "is-success";
            } else {
              state.statusText = "Aucune entrée d’heure pour ce jour";
              state.statusVariant = "is-empty";
            }

            renderStatus();
            renderSummary();
            renderBadge();
          };

	          const watchSelectedDate = async () => {
	            const clientId = clientIdInput.value;
	            const selectedDate = dateInput.value;
	            state.selectedDate = selectedDate;

            if (!clientId || !selectedDate) {
              if (activeController) {
                activeController.abort();
	                activeController = null;
	              }
                state.isLoading = false;
	              setFormState({
	                entry: null,
	                statusText: "",
	                statusVariant: "",
	                resolvedKey: "",
              });
              return;
            }

            const requestKey = getRequestKey(clientId, selectedDate);
	            if (requestKey === state.lastResolvedKey) {
	              return;
	            }

	            const cachedEntry = entryCache.get(requestKey);
	            if (cachedEntry) {
              setFormState({
                entry: cachedEntry,
                statusText: "Entrée existante pour ce jour",
                statusVariant: "is-success",
                resolvedKey: requestKey,
              });
	              return;
	            }

	            if (activeController) {
	              activeController.abort();
	            }

	            const controller = new AbortController();
	            activeController = controller;
              state.isLoading = true;
              state.statusText = "Chargement de la journee selectionnee...";
              state.statusVariant = "is-loading";
              renderStatus();
              renderBadge();

	            try {
	              const response = await fetch(
	                `/api/entries/by-date?clientId=${encodeURIComponent(clientId)}&date=${encodeURIComponent(selectedDate)}`,
	                {
                  headers: { Accept: "application/json" },
                  signal: controller.signal,
                }
              );

              if (!response.ok) {
                if (!controller.signal.aborted) {
                  state.lastResolvedKey = "";
                }
                return;
              }

              const payload = await response.json();
              if (controller.signal.aborted || dateInput.value !== selectedDate || clientIdInput.value !== clientId) {
                return;
              }

              if (payload && payload.entry) {
                persistEntryInCache({ ...payload.entry, isExisting: true });
                setFormState({
                  entry: { ...payload.entry, isExisting: true },
                  statusText: "Entrée existante pour ce jour",
                  statusVariant: "is-success",
                  resolvedKey: requestKey,
                });
                return;
              }

	              setFormState({
	                entry: null,
	                statusText: "Aucune entrée d’heure pour ce jour",
	                statusVariant: "is-empty",
                resolvedKey: requestKey,
              });
            } catch (error) {
	              if (error && error.name === "AbortError") {
	                return;
	              }
              state.isLoading = false;
	              state.lastResolvedKey = "";
              state.statusText = "";
              state.statusVariant = "";
              renderStatus();
              renderBadge();
	            } finally {
	              if (activeController === controller) {
	                activeController = null;
	              }
	            }
	          };

	          dateInput.addEventListener("input", watchSelectedDate);
	          dateInput.addEventListener("change", watchSelectedDate);
          [dayTypeSelect, arrivalInput, departureInput, lunchInput].forEach((field) => {
            field.addEventListener("input", markUnsavedIfNeeded);
            field.addEventListener("change", markUnsavedIfNeeded);
          });
          commentInput.addEventListener("input", () => {
            autosizeComment();
            markUnsavedIfNeeded();
          });

	          entryForm.addEventListener("submit", () => {
	            const submittedEntry = readEntryFromForm();
	            if (!submittedEntry.workDate) {
	              return;
	            }

            state.isSaving = true;
            state.statusText = "Enregistrement de la journee...";
            state.statusVariant = "is-loading";
            renderStatus();
            renderBadge();
            updateSubmitButton(submitButton.dataset.savingLabel || "Enregistrement...", true);

            try {
              sessionStorage.setItem(
                SAVE_FLASH_STORAGE_KEY,
                JSON.stringify({
                  clientId: clientIdInput.value,
                  workDate: submittedEntry.workDate,
                  savedAt: Date.now(),
                })
              );
            } catch (error) {
              // Ignore storage issues.
            }

	            persistEntryInCache({ ...submittedEntry, isExisting: true });
	            setFormState({
	              entry: { ...submittedEntry, isExisting: true },
	              statusText: "Entrée existante pour ce jour",
	              statusVariant: "is-success",
              resolvedKey: getRequestKey(clientIdInput.value, submittedEntry.workDate),
            });
          });

	          state.currentEntry = readEntryFromForm();

	          if (originalWorkDateInput.value && dateInput.value) {
	            persistEntryInCache({
              workDate: originalWorkDateInput.value,
              isExisting: true,
              dayType: dayTypeSelect.value,
              arrivalTime: arrivalInput.value,
              departureTime: departureInput.value,
              lunchBreakMinutes: lunchInput.value,
              commentText: commentInput.value,
	            });
	            state.lastResolvedKey = getRequestKey(clientIdInput.value, dateInput.value);
	          }

            try {
              const rawSaveFlash = sessionStorage.getItem(SAVE_FLASH_STORAGE_KEY);
              if (rawSaveFlash) {
                const saveFlash = JSON.parse(rawSaveFlash);
                if (
                  saveFlash &&
                  saveFlash.clientId === clientIdInput.value &&
                  saveFlash.workDate === dateInput.value &&
                  Date.now() - Number(saveFlash.savedAt || 0) < 15000 &&
                  !document.querySelector(".alert")
                ) {
                  updateSubmitButton(submitButton.dataset.successLabel || "✓ Journée enregistrée", true);
                  window.setTimeout(() => {
                    updateSubmitButton(submitButton.dataset.defaultLabel || "Enregistrer", false);
                  }, 1400);
                }
                sessionStorage.removeItem(SAVE_FLASH_STORAGE_KEY);
              }
            } catch (error) {
              // Ignore storage issues.
            }

	            autosizeComment();
		          renderEntry();
	            renderSummary();
	            markUnsavedIfNeeded();
		      })();

	      (() => {
	        const dateInput = document.getElementById("date");
	        const calendarCards = Array.from(document.querySelectorAll("[data-calendar-day]"));
	        const filterButtons = Array.from(document.querySelectorAll("[data-day-filter]"));
	        const emptyMessage = document.querySelector("[data-calendar-empty]");

	        if (!dateInput || calendarCards.length === 0) {
	          return;
	        }

	        const syncSelectedCard = () => {
	          const selectedDate = dateInput.value || "";
	          calendarCards.forEach((card) => {
	            const isSelected = card.dataset.date === selectedDate;
	            card.classList.toggle("is-selected", isSelected);
	            card.setAttribute("aria-pressed", String(isSelected));
	          });
	        };

