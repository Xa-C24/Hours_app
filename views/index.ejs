                  <input type="hidden" name="clientId" value="<%= _selectedClientId %>" />
                  <label for="salaryAmountInline">Montant</label>
                  <input
                    id="salaryAmountInline"
                    name="salaryAmount"
                    type="number"
                    min="0"
                    step="0.01"
                    inputmode="decimal"
                    value="<%= salaryAmountInput %>"
                    placeholder="Ex: 4850.00"
                  />
                  <button type="submit" data-ripple>OK</button>
                </form>
              </details>
              <strong><%= salaryAmountDisplay %></strong>
              <% if (hourlyRateDisplay) { %>
              <span><%= hourlyRateDisplay %> sur <%= totalHHMM %></span>
              <% } %>
            </div>
          </div>
          <% } %>
        </div>
      </section>
