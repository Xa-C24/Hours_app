            </div>
            <div class="history-premium-total">
              <span>Heures sup</span>
              <strong><%= totalOvertimeHHMM %></strong>
            </div>
            <div class="history-premium-total">
              <span>Récup</span>
              <strong><%= totalRecoveredHHMM %></strong>
            </div>
            <div class="history-premium-total history-premium-total-salary">
