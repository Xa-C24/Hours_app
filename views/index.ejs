    <script src="/theme.js"></script>
    <script>
      (() => {
        const commentField = document.querySelector("[data-comment-target]");
        const emojiPicker = document.querySelector(".comment-emoji-component");
        const emojiPickerDetails = document.querySelector(".comment-emoji-picker");

        if (!commentField || !emojiPicker || !emojiPickerDetails) {
          return;
        }

        const insertEmoji = (emoji) => {
          const start = commentField.selectionStart ?? commentField.value.length;
          const end = commentField.selectionEnd ?? commentField.value.length;
          const prefix = start > 0 && !/\s$/.test(commentField.value.slice(0, start)) ? " " : "";
          const suffix = end < commentField.value.length && !/^\s/.test(commentField.value.slice(end)) ? " " : "";
          const insertedText = `${prefix}${emoji}${suffix}`;

          commentField.setRangeText(insertedText, start, end, "end");
          commentField.focus();
        };

        emojiPicker.addEventListener("emoji-click", (event) => {
          const emoji = event.detail && typeof event.detail.unicode === "string"
            ? event.detail.unicode
            : "";
          if (!emoji) {
            return;
          }
          insertEmoji(emoji);
          emojiPickerDetails.open = false;
        });
      })();

      (() => {
        const dayTypeSelect = document.querySelector("[data-day-type-select]");
        const workedDayFields = [...document.querySelectorAll("[data-worked-day-field]")];
        const workedDayTypes = new Set(["office", "remote"]);

        if (!dayTypeSelect || workedDayFields.length === 0) {
          return;
        }

        const syncWorkedDayFields = () => {
          const isWorkedDay = workedDayTypes.has(dayTypeSelect.value);
          workedDayFields.forEach((field) => {
            field.disabled = !isWorkedDay;
            field.required = isWorkedDay;
          });
        };

        dayTypeSelect.addEventListener("change", syncWorkedDayFields);
        syncWorkedDayFields();
      })();

	      (() => {
	        const entryForm = document.querySelector("[data-entry-form]");
	        const clientIdInput = entryForm ? entryForm.querySelector('input[name="clientId"]') : null;
	        const originalWorkDateInput = entryForm ? entryForm.querySelector('input[name="originalWorkDate"]') : null;
	        const dateInput = entryForm ? entryForm.querySelector("#date") : null;
	        const dayTypeSelect = entryForm ? entryForm.querySelector("#dayType") : null;
	        const arrivalInput = entryForm ? entryForm.querySelector("#arrivalTime") : null;
	        const departureInput = entryForm ? entryForm.querySelector("#departureTime") : null;
	        const lunchInput = entryForm ? entryForm.querySelector("#lunchBreakMinutes") : null;
	        const commentInput = entryForm ? entryForm.querySelector("#commentText") : null;
	        const statusMessage = entryForm ? entryForm.querySelector("[data-entry-load-status]") : null;
	        let activeController = null;
	        let lastRequestedKey = "";
	        let lastLoadedKey = "";

	        if (
	          !entryForm ||
	          !clientIdInput ||
	          !originalWorkDateInput ||
	          !dateInput ||
	          !dayTypeSelect ||
	          !arrivalInput ||
	          !departureInput ||
	          !lunchInput ||
	          !commentInput ||
	          !statusMessage
	        ) {
	          return;
	        }

          const defaultFormValues = {
            dayType: entryForm.dataset.defaultDayType || "office",
            arrivalTime: entryForm.dataset.defaultArrivalTime || "",
            departureTime: entryForm.dataset.defaultDepartureTime || "",
            lunchBreakMinutes: entryForm.dataset.defaultLunchBreakMinutes || "",
            commentText: entryForm.dataset.defaultCommentText || "",
          };

          const setStatusMessage = (text, variant) => {
            statusMessage.textContent = text || "";
            statusMessage.hidden = !text;
            statusMessage.classList.remove("is-success", "is-empty");
            if (variant) {
              statusMessage.classList.add(variant);
            }
          };

	        const applyEntryToForm = (entry) => {
	          originalWorkDateInput.value = entry.workDate || dateInput.value;
	          dayTypeSelect.value = entry.dayType || "office";
	          arrivalInput.value = entry.arrivalTime || "";
	          departureInput.value = entry.departureTime || "";
	          lunchInput.value = entry.lunchBreakMinutes || "";
	          commentInput.value = entry.commentText || "";
	          dayTypeSelect.dispatchEvent(new Event("change", { bubbles: true }));
	        };

          const resetFormToDefaults = () => {
            originalWorkDateInput.value = "";
            dayTypeSelect.value = defaultFormValues.dayType;
            arrivalInput.value = defaultFormValues.arrivalTime;
            departureInput.value = defaultFormValues.departureTime;
            lunchInput.value = defaultFormValues.lunchBreakMinutes;
            commentInput.value = defaultFormValues.commentText;
            dayTypeSelect.dispatchEvent(new Event("change", { bubbles: true }));
          };

	        const maybeAutofillEntry = async () => {
	          const clientId = clientIdInput.value;
	          const selectedDate = dateInput.value;
	          if (!clientId || !selectedDate) {
              if (activeController) {
                activeController.abort();
                activeController = null;
              }
              lastRequestedKey = "";
              lastLoadedKey = "";
              resetFormToDefaults();
              setStatusMessage("", "");
	            return;
	          }

            const requestKey = `${clientId}:${selectedDate}`;
            if (requestKey === lastLoadedKey) {
              return;
            }

	          if (activeController) {
	            activeController.abort();
	          }

	          const controller = new AbortController();
	          activeController = controller;
	          lastRequestedKey = requestKey;

	          try {
	            const response = await fetch(
	              `/api/entries/by-date?clientId=${encodeURIComponent(clientId)}&date=${encodeURIComponent(selectedDate)}`,
              {
                headers: { Accept: "application/json" },
                signal: controller.signal,
              }
	            );

	            if (!response.ok) {
                lastLoadedKey = "";
                setStatusMessage("", "");
	              return;
	            }

	            const payload = await response.json();
	            if (controller.signal.aborted || `${clientIdInput.value}:${dateInput.value}` !== lastRequestedKey) {
	              return;
	            }

	            if (payload && payload.entry) {
	              applyEntryToForm(payload.entry);
                setStatusMessage("Entrée existante pour ce jour", "is-success");
              } else {
                resetFormToDefaults();
                setStatusMessage("Aucune entrée d’heure pour ce jour", "is-empty");
	            }
              lastLoadedKey = requestKey;
	          } catch (error) {
	            if (error && error.name === "AbortError") {
	              return;
	            }
            lastLoadedKey = "";
            setStatusMessage("", "");
	          } finally {
              if (activeController === controller) {
                activeController = null;
              }
	          }
	        };

        dateInput.addEventListener("change", maybeAutofillEntry);
      })();

      (() => {
        const modal = document.querySelector("[data-client-modal]");
        const openButtons = [...document.querySelectorAll("[data-open-client-modal]")];
        const closeButtons = [...document.querySelectorAll("[data-close-client-modal]")];
        const firstInput = modal ? modal.querySelector("#clientCompanyName") : null;

        if (!modal) {
          return;
        }

        const openModal = () => {
          modal.hidden = false;
          document.body.style.overflow = "hidden";
          window.setTimeout(() => {
            firstInput && firstInput.focus();
          }, 0);
        };

        const closeModal = () => {
          modal.hidden = true;
          document.body.style.overflow = "";
        };

        openButtons.forEach((button) => {
          button.addEventListener("click", openModal);
        });

        closeButtons.forEach((button) => {
          button.addEventListener("click", closeModal);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !modal.hidden) {
            closeModal();
          }
        });

        if (!modal.hidden) {
          document.body.style.overflow = "hidden";
          firstInput && firstInput.focus();
        }
      })();

      (() => {
        const modal = document.querySelector("[data-client-info-modal]");
        const openButtons = [...document.querySelectorAll("[data-open-client-info-modal]")];
        const closeButtons = [...document.querySelectorAll("[data-close-client-info-modal]")];

        if (!modal) {
          return;
        }

        const openModal = () => {
          modal.hidden = false;
          document.body.style.overflow = "hidden";
        };

        const closeModal = () => {
          modal.hidden = true;
          document.body.style.overflow = "";
        };

        openButtons.forEach((button) => {
          if (!button.disabled) {
            button.addEventListener("click", openModal);
          }
        });

        closeButtons.forEach((button) => {
          button.addEventListener("click", closeModal);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !modal.hidden) {
            closeModal();
          }
        });
      })();

      (() => {
        const modal = document.querySelector("[data-confirm-replace-modal]");
        const closeButtons = [...document.querySelectorAll("[data-close-confirm-replace-modal]")];
        const confirmButton = document.querySelector("[data-confirm-replace-submit]");
        const entryForm = document.querySelector("[data-entry-form]");
        const confirmReplaceInput = document.querySelector("[data-confirm-replace-input]");
        const firstField = entryForm ? entryForm.querySelector("#date") : null;

        if (!modal || !entryForm || !confirmReplaceInput) {
          return;
        }

        const openModal = () => {
          modal.hidden = false;
          document.body.style.overflow = "hidden";
          window.setTimeout(() => {
            const focusTarget = confirmButton || closeButtons[0];
            if (focusTarget) {
              focusTarget.focus();
            }
          }, 0);
        };

        const closeModal = () => {
          modal.hidden = true;
          document.body.style.overflow = "";
          confirmReplaceInput.value = "";
          if (firstField) {
            firstField.focus();
          }
        };

        closeButtons.forEach((button) => {
          button.addEventListener("click", closeModal);
        });

        if (confirmButton) {
          confirmButton.addEventListener("click", () => {
            confirmReplaceInput.value = "1";
            entryForm.requestSubmit();
          });
        }

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !modal.hidden) {
            closeModal();
          }
        });

        if (!modal.hidden) {
          openModal();
        }
      })();

      (() => {
        const card = document.querySelector("[data-archived-clients-card]");
        const toggleButton = document.querySelector("[data-archived-clients-toggle]");
        const panel = document.querySelector("[data-archived-clients-panel]");
        const searchInput = document.querySelector("[data-archived-client-search]");
        const items = [...document.querySelectorAll("[data-archived-client-item]")];
        const emptyState = document.querySelector("[data-archived-client-empty]");

        if (!card || !toggleButton || !panel) {
          return;
        }

        const setCollapsed = (collapsed) => {
          card.classList.toggle("is-collapsed", collapsed);
          panel.hidden = collapsed;
          toggleButton.setAttribute("aria-expanded", String(!collapsed));
        };

        toggleButton.addEventListener("click", () => {
          setCollapsed(!card.classList.contains("is-collapsed"));
        });

        items.forEach((item) => {
          const history = item.querySelector("[data-archived-history]");
          const historyToggle = item.querySelector("[data-archived-history-toggle]");
          if (!history || !historyToggle) {
            return;
          }
          historyToggle.addEventListener("click", () => {
            const nextVisible = history.hidden;
            history.hidden = !nextVisible;
            historyToggle.setAttribute("aria-expanded", String(nextVisible));
            historyToggle.textContent = nextVisible ? "Masquer historique" : "Voir historique";
          });
        });

        if (searchInput) {
          searchInput.addEventListener("input", () => {
            const query = searchInput.value.trim().toLowerCase();
            let visibleCount = 0;
            items.forEach((item) => {
              const name = item.dataset.clientName || "";
              const visible = !query || name.includes(query);
              item.hidden = !visible;
              if (visible) {
                visibleCount += 1;
              }
            });
            if (emptyState) {
              emptyState.hidden = visibleCount > 0;
            }
          });
        }
      })();

      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
