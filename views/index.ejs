<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f2937" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Hours" />
    <title>Suivi des heures</title>
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/icon-512.png" />
    <link rel="manifest" href="/manifest.json" />
    <script type="module" src="/vendor/emoji-picker-element/index.js"></script>
    <script>
      (() => {
        const themeKey = "hours_theme";
        const styleKey = "hours_style";
        const allowedThemes = ["light", "dark", "deep-ocean-blue", "light-blue", "orange-sunset", "forest-green", "light-green", "robot"];
        const allowedStyles = ["premium", "robot", "retro"];
        try {
          const storedTheme = localStorage.getItem(themeKey) || "light";
          const theme = storedTheme === "futuristic-robot" ? "robot" : storedTheme;
          const storedStyle = localStorage.getItem(styleKey) || "";
          const style = allowedStyles.includes(storedStyle) ? storedStyle : theme === "robot" ? "robot" : "premium";
          document.documentElement.setAttribute("data-theme", allowedThemes.includes(theme) ? theme : "light");
          document.documentElement.setAttribute("data-style", style);
        } catch (error) {
          document.documentElement.setAttribute("data-theme", "light");
          document.documentElement.setAttribute("data-style", "premium");
        }
      })();
    </script>
    <link rel="stylesheet" href="/style.css" />
    <style>
      .client-switch-form {
        display: flex;
        align-items: end;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      .client-switch-form .theme-picker {
        min-width: 230px;
      }

      .client-add-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 3rem;
        min-height: 3rem;
        padding-inline: 0.95rem;
      }

      .client-view-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 3rem;
        min-height: 3rem;
        padding-inline: 0.95rem;
      }

      .client-empty-card {
        margin-top: 2rem;
        padding: 1.4rem;
      }

      .client-empty-card p {
        margin: 0.5rem 0 0;
      }

      .client-modal[hidden] {
        display: none;
      }

      .client-modal {
        position: fixed;
        inset: 0;
        z-index: 40;
        display: grid;
        place-items: center;
        padding: 1rem;
      }

      .client-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(8, 15, 27, 0.62);
        backdrop-filter: blur(8px);
      }

      .client-modal-dialog {
        position: relative;
        z-index: 1;
        width: min(100%, 720px);
        max-height: calc(100vh - 2rem);
        overflow: auto;
        padding: 1.2rem;
      }

      .client-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .client-modal-header h2 {
        margin: 0;
      }

      .client-modal-close {
        width: 2.2rem;
        min-width: 2.2rem;
        height: 2.2rem;
        padding: 0;
      }

      .client-modal-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
      }

      .client-modal-grid .field-full {
        grid-column: 1 / -1;
      }

      .confirm-replace-copy {
        margin: 0 0 1rem;
        color: var(--text-secondary);
      }

      .confirm-replace-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .client-info-list {
        display: grid;
        gap: 0.8rem;
      }

      .client-info-item {
        display: grid;
        gap: 0.18rem;
        padding: 0.9rem 1rem;
        border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
        border-radius: 14px;
        background: color-mix(in srgb, var(--card-bg) 92%, transparent);
      }

      .client-info-item strong {
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .client-info-item span {
        word-break: break-word;
      }

      .archived-clients-card {
        margin-top: 2rem;
        padding: 1.2rem;
      }

      .archived-clients-card.is-collapsed .card-toggle-icon {
        transform: rotate(-90deg);
      }

      .archived-clients-panel[hidden],
      .archived-history[hidden] {
        display: none;
      }

      .archived-clients-toolbar {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin: 1rem 0 1.15rem;
      }

      .archived-clients-toolbar .field {
        display: flex;
        flex: 1 1 22rem;
        max-width: 34rem;
        flex-direction: column;
        gap: 0.42rem;
      }

      .archived-clients-toolbar label {
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .archived-clients-toolbar input {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: var(--radius-control);
        background: var(--input-bg);
        color: var(--text);
        font: inherit;
        min-height: 3rem;
        padding: 0.8rem 0.95rem;
        outline: none;
        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease;
      }

      .archived-clients-toolbar input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px var(--focus-ring);
      }

      .archived-clients-list {
        display: grid;
        gap: 0.85rem;
      }

      .archived-client-item {
        border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
        border-radius: var(--radius-control);
        padding: 1rem 1.05rem;
        background: color-mix(in srgb, var(--card-bg) 94%, transparent);
      }

      .archived-client-summary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 1rem;
      }

      .archived-client-name {
        display: block;
        font-weight: 800;
        word-break: break-word;
      }

      .archived-client-meta {
        display: block;
        margin-top: 0.22rem;
        color: var(--muted);
        font-size: 0.88rem;
      }

      .archived-client-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.45rem;
        flex-wrap: wrap;
      }

      .archived-client-actions .button-link,
      .archived-client-actions button {
        min-width: 8.5rem;
        white-space: nowrap;
      }

      .archived-client-actions form {
        margin: 0;
        display: flex;
      }

      .archived-delete-button {
        min-width: 2.75rem !important;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .archived-delete-button svg {
        width: 1.05rem;
        height: 1.05rem;
      }

      .archived-history {
        margin-top: 0.9rem;
      }

      .pay-period-card.is-collapsed .card-toggle-icon {
        transform: rotate(-90deg);
      }

      .pay-period-card .month-header {
        display: grid;
        grid-template-columns: minmax(0, auto) minmax(18rem, 1fr) auto;
        align-items: end;
      }

      .pay-period-card .month-tools {
        justify-content: end;
      }

      .pay-period-panel[hidden] {
        display: none;
      }

      .app-footer {
        margin: 2rem 0 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
        border-radius: 18px;
        background: color-mix(in srgb, var(--card-bg) 86%, transparent);
        color: var(--muted);
      }

      .app-footer-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.85rem;
        flex-wrap: wrap;
      }

      .app-footer p {
        margin: 0;
      }

      .app-footer a {
        color: var(--link);
        font-weight: 700;
        text-decoration: none;
      }

      .app-footer a:hover {
        color: var(--link-hover);
        text-decoration: underline;
      }

      @media (max-width: 700px) {
        .client-switch-form {
          width: 100%;
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto auto;
          align-items: end;
          gap: 0.55rem;
        }

        .client-switch-form .theme-picker {
          min-width: 0;
        }

        .client-view-button,
        .client-add-button {
          width: 2.9rem;
          min-width: 2.9rem;
          min-height: 2.9rem;
          padding-inline: 0;
        }

        .client-switch-form > * {
          min-width: 0;
        }

        .client-modal {
          align-items: end;
          padding:
            max(0.75rem, env(safe-area-inset-top))
            max(0.7rem, env(safe-area-inset-right))
            max(0.75rem, env(safe-area-inset-bottom))
            max(0.7rem, env(safe-area-inset-left));
        }

        .client-modal-dialog {
          width: 100%;
          max-height: min(84vh, calc(100vh - 1.5rem));
          padding: 1rem 0.9rem;
          border-radius: 18px;
        }

        .client-modal-header {
          position: sticky;
          top: 0;
          z-index: 2;
          padding-bottom: 0.4rem;
          background: inherit;
        }

        .client-modal-grid {
          grid-template-columns: 1fr;
        }

        .archived-clients-toolbar {
          display: block;
        }

        .archived-clients-toolbar .field {
          max-width: none;
        }

        .archived-client-summary {
          grid-template-columns: 1fr;
          align-items: stretch;
        }

        .archived-client-actions {
          justify-content: flex-start;
        }

        .archived-client-actions .button-link,
        .archived-client-actions form,
        .archived-client-actions button {
          width: 100%;
          min-width: 0;
        }

        .pay-period-card .month-header {
          grid-template-columns: minmax(0, 1fr) auto;
        }

        .pay-period-card .month-tools {
          grid-column: 1 / -1;
          order: 3;
        }

        .app-footer-content {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (max-width: 480px) {
        .client-switch-form {
          grid-template-columns: 1fr;
        }

        .client-view-button,
        .client-add-button {
          width: 100%;
          min-width: 0;
        }

        .client-modal-dialog {
          max-height: min(88vh, calc(100vh - 1rem));
          padding: 0.92rem 0.82rem;
        }

        .client-modal-header h2 {
          font-size: 1.35rem;
        }

        .client-info-item {
          padding: 0.78rem 0.82rem;
        }
      }
    </style>
  </head>
  <body class="home-premium-page">
    <% const _csrfToken = typeof csrfToken === "string" ? csrfToken : ""; %>
    <% const _isEditing = typeof isEditing !== "undefined" ? isEditing : false; %>
    <% const _editingWorkDate = typeof editingWorkDate === "string" ? editingWorkDate : ""; %>
    <% const _selectedClientId = selectedClient ? selectedClient.id : ""; %>
    <% const _clientError = typeof clientError === "string" ? clientError : ""; %>
    <% const _errorMessage = typeof error === "string" ? error : ""; %>
    <% const _showReplaceConfirmation = typeof showReplaceConfirmation !== "undefined" ? Boolean(showReplaceConfirmation) : false; %>
    <% const _showSalaryEditor = typeof showSalaryEditor !== "undefined" ? Boolean(showSalaryEditor) : false; %>
    <% const _showClientModal = typeof showClientModal !== "undefined" ? Boolean(showClientModal) : false; %>
    <% const _showClientInfoModal = typeof showClientInfoModal !== "undefined" ? Boolean(showClientInfoModal) : false; %>
    <% const _workedDayCount = typeof workedDayCount === "number" ? workedDayCount : 0; %>
    <% const _payPeriodStartDate = typeof payPeriodStartDate === "string" ? payPeriodStartDate : ""; %>
    <% const _payPeriodEndDate = typeof payPeriodEndDate === "string" ? payPeriodEndDate : ""; %>
    <% const _payPeriodLabel = typeof payPeriodLabel === "string" ? payPeriodLabel : ""; %>
    <% const _clientFormData = clientFormData && typeof clientFormData === "object" ? clientFormData : {}; %>
    <%
      const _userFirstName = user && typeof user.first_name === "string" ? user.first_name.trim() : "";
      const _userLastName = user && typeof user.last_name === "string" ? user.last_name.trim() : "";
      const _userFullName = [_userFirstName, _userLastName].filter(Boolean).join(" ").trim();
      const authUser = _userFullName || (user && typeof user.email === "string" ? user.email.trim() : "");
      const _userCompanyName = user && typeof user.company_name === "string" ? user.company_name.trim() : "";
      const _userJobTitle = user && typeof user.job_title === "string" ? user.job_title.trim() : "";
      const _userEmail = user && typeof user.email === "string" ? user.email.trim() : "";
      const _mobileNavItems = [
        { key: "dashboard", label: "Dashboard", icon: "◈" },
        { key: "entry", label: "Saisie", icon: "✎" },
        { key: "calendar", label: "Calendrier", icon: "▦" },
        { key: "history", label: "Historique", icon: "🗂" },
        { key: "stats", label: "Stats", icon: "◔" },
        { key: "settings", label: "Réglages", icon: "⚙" },
      ];
      const _settingsSections = [
        { key: "profile", icon: "👤", label: "Profil", description: "Informations personnelles et identité visuelle." },
        { key: "work", icon: "💼", label: "Travail", description: "Cadre de travail, horaires et rythme par défaut." },
        { key: "goals", icon: "🎯", label: "Objectifs", description: "Repères journaliers, hebdomadaires et annuels." },
        { key: "appearance", icon: "🎨", label: "Apparence", description: "Thème, accent et confort visuel." },
        { key: "notifications", icon: "🔔", label: "Notifications", description: "Rappels et hooks de communication." },
        { key: "export", icon: "📄", label: "Export", description: "Formats, branding et conventions de sortie." },
        { key: "security", icon: "🔐", label: "Sécurité", description: "Accès, sessions et protection du compte." },
        { key: "help", icon: "📚", label: "Centre d'aide", description: "Base de connaissances, FAQ et support." },
        { key: "about", icon: "❤️", label: "À propos", description: "Version, licence, roadmap et changelog." },
      ];
      const _settingsGoalCards = [
        { label: "Journalier", value: "7 h 00", meta: "Repère par journée travaillée" },
        { label: "Hebdomadaire", value: "35 h 00", meta: "Vision sprint sur cinq jours" },
        { label: "Mensuel", value: "140 h", meta: "Projection premium sur la période active" },
        { label: "Annuel", value: "1 607 h", meta: "Capacité cible et pilotage long terme" },
      ];
      const _settingsHelpCategories = [
        "Premiers pas",
        "Créer un client",
        "Créer une journée",
        "Calendrier",
        "Exports",
        "Objectifs",
        "FAQ",
        "Raccourcis clavier",
        "Roadmap",
        "Support",
      ];
      const _settingsPaletteItems = _settingsSections.map((section) => ({
        key: section.key,
        icon: section.icon,
        label: section.label,
        description: section.description,
        aliases: `${section.label} ${section.description}`.toLowerCase(),
      }));
    %>
    <main class="container">
      <div class="between-sections-spacer" aria-hidden="true"></div>
      <header class="page-header page-header-premium">
        <div class="page-header-copy">
          <h1>Suivi mensuel des heures de travail</h1>
        </div>
        <div class="header-actions">
          <form action="/" method="get" class="client-switch-form">
            <input type="hidden" name="month" value="<%= selectedMonth %>" />
            <div class="theme-picker">
              <label for="clientSelectApp">Client</label>
              <select id="clientSelectApp" name="clientId" onchange="this.form.submit()">
                <% if (clients.length === 0) { %>
                <option value="">Aucun client</option>
                <% } %>
                <% clients.forEach((client) => { %>
                <option value="<%= client.id %>" <%= selectedClient && selectedClient.id === client.id ? "selected" : "" %>>
                  <%= client.company_name %>
                </option>
                <% }); %>
              </select>
            </div>
            <button
              type="button"
              class="client-view-button secondary"
              data-open-client-info-modal
              data-ripple
              aria-label="Voir les informations du client"
              title="Afficher détail"
              <%= selectedClient ? "" : "disabled" %>
            >
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="3"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                />
              </svg>
            </button>
            <button
              type="button"
              class="client-add-button"
              data-open-client-modal
              data-ripple
              aria-label="Ajouter un client"
              title="Ajouter un client"
            >+</button>
          </form>
          <div class="theme-picker">
            <label for="themeSelectApp">Theme</label>
            <select id="themeSelectApp" data-theme-selector>
              <option value="light">Ivoire</option>
              <option value="dark">Nuit graphite</option>
              <option value="deep-ocean-blue">Bleu minuit</option>
              <option value="light-blue">Brume bleue</option>
              <option value="orange-sunset">Sable cuivre</option>
              <option value="forest-green">Sauge profonde</option>
              <option value="light-green">Celadon</option>
            </select>
          </div>
          <div class="theme-picker">
            <label for="styleSelectApp">Style</label>
            <select id="styleSelectApp" data-style-selector>
              <option value="premium">Premium</option>
              <option value="robot">Robot</option>
              <option value="retro">SEGA</option>
            </select>
          </div>
	          <details class="user-menu">
	            <summary class="user-menu-trigger" aria-label="Ouvrir le menu utilisateur">
	              <% if (authUser) { %>
	              <span class="user-chip"><%= authUser %></span>
	              <% } else { %>
	              <span class="user-chip">Compte</span>
	              <% } %>
	              <span class="user-menu-caret" aria-hidden="true">▾</span>
	            </summary>
	            <div class="user-menu-panel app-card-compact">
	              <button type="button" class="button-link button-neutral user-menu-link" data-open-settings-workspace data-settings-target="profile" data-ripple>
	                ⚙️ Paramètres
	              </button>
	              <button type="button" class="button-link button-neutral user-menu-link" data-open-settings-workspace data-settings-target="help" data-ripple>
	                📚 Centre d'aide
	              </button>
	              <button type="button" class="button-link button-neutral user-menu-link" data-open-command-palette data-ripple>
	                ⌘K Command Palette
	              </button>
	              <form action="/logout" method="post" class="logout-form user-menu-logout">
	                <button type="submit" class="secondary" data-ripple>Déconnexion</button>
	              </form>
	            </div>
	          </details>
	        </div>
	      </header>

      <% if (_clientError) { %>
      <p class="alert"><%= _clientError %></p>
      <% } %>

	      <% if (_errorMessage && !_showReplaceConfirmation) { %>
	      <p class="alert"><%= _errorMessage %></p>
	      <% } %>

	      <section class="settings-workspace card premium-surface app-surface app-card" data-settings-workspace hidden>
	        <div class="settings-shell">
	          <aside class="settings-sidebar">
	            <div class="settings-sidebar-head">
	              <span class="section-eyebrow">⚙️ Paramètres</span>
	              <h2>Centre des paramètres</h2>
	              <p>Un workspace personnel pour organiser profil, travail, sécurité, exports et support sans toucher au métier.</p>
	            </div>
	            <nav class="settings-nav" aria-label="Navigation paramètres">
	              <% _settingsSections.forEach((section, index) => { %>
	              <button
	                type="button"
	                class="settings-nav-item<%= index === 0 ? ' is-active' : '' %>"
	                data-settings-nav-item
	                data-settings-target="<%= section.key %>"
	                aria-pressed="<%= index === 0 ? 'true' : 'false' %>"
	              >
	                <span class="settings-nav-icon" aria-hidden="true"><%= section.icon %></span>
	                <span class="settings-nav-copy">
	                  <strong><%= section.label %></strong>
	                  <span><%= section.description %></span>
	                </span>
	              </button>
	              <% }); %>
	            </nav>
	          </aside>
	          <div class="settings-content">
	            <header class="settings-content-head">
	              <div>
	                <span class="section-eyebrow">Personal Workspace</span>
	                <h2>Préférences, posture de travail et centre d'aide</h2>
	              </div>
	              <div class="settings-head-actions">
	                <button type="button" class="button-link button-neutral" data-open-command-palette data-ripple>⌘K Command Palette</button>
	                <button type="button" class="button-link button-neutral" data-close-settings-workspace data-ripple>Fermer</button>
	              </div>
	            </header>

	            <section class="settings-panel" data-settings-section="profile">
	              <div class="settings-panel-head">
	                <div>
	                  <span class="section-eyebrow">👤 Profil</span>
	                  <h3>Identité du workspace</h3>
	                </div>
	                <span class="badge-muted">Hook prêt</span>
	              </div>
	              <div class="settings-profile-hero app-card-compact">
	                <div class="settings-avatar-stack">
	                  <div class="settings-avatar-art" aria-hidden="true"><%= authUser ? authUser.slice(0, 1).toUpperCase() : "H" %></div>
	                  <button type="button" class="button-link button-neutral">Changer la photo</button>
	                </div>
	                <div class="settings-hero-copy">
	                  <strong><%= authUser || "Votre espace" %></strong>
	                  <span>Préparez votre photo, votre signature visuelle et les métadonnées visibles dans l'application.</span>
	                </div>
	              </div>
	              <div class="settings-grid settings-grid-profile">
	                <div class="form-field">
	                  <label class="form-label" for="settingsProfileName">Nom</label>
	                  <input class="form-input" id="settingsProfileName" type="text" placeholder="Nom complet" value="<%= authUser || '' %>" />
	                </div>
	                <div class="form-field">
	                  <label class="form-label" for="settingsProfileCompany">Entreprise</label>
		                  <input class="form-input" id="settingsProfileCompany" type="text" placeholder="Nom de société" value="<%= _userCompanyName || (selectedClient ? selectedClient.name : '') %>" />
	                </div>
