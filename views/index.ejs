        const _todayDate = defaultEntryFormData && defaultEntryFormData.date ? defaultEntryFormData.date : formData.date;
        const _todayEntry = entries.find((entry) => entry.work_date === _todayDate) || null;
        const _todayWorkedMinutes = _todayEntry ? Number(_todayEntry.worked_minutes || 0) : 0;
        const _todayWorkedHHMM = _todayEntry ? _todayEntry.worked_hhmm : "00:00";
        const _todayTargetMinutes = _todayEntry ? Number(_todayEntry.target_minutes || 0) : 7 * 60;
        const _todayTargetHHMM = _todayTargetMinutes > 0 ? `${String(Math.floor(_todayTargetMinutes / 60)).padStart(2, "0")}:${String(_todayTargetMinutes % 60).padStart(2, "0")}` : "00:00";
        const _todayProgress = _todayTargetMinutes > 0 ? Math.max(0, Math.min(100, Math.round((_todayWorkedMinutes / _todayTargetMinutes) * 100))) : 0;
        const _todayMeta = _todayEntry
          ? `${_todayEntry.day_type_display}${_todayEntry.is_worked_day ? ` · ${_todayEntry.arrival_time_display} - ${_todayEntry.departure_time_display}` : ""}`
          : "Aucune saisie sur la journée en cours";
        const _todayProgressMeta =
          _todayWorkedMinutes >= _todayTargetMinutes
            ? "Objectif atteint ou dépassé"
            : `${Math.max(0, _todayTargetMinutes - _todayWorkedMinutes)} min restantes pour l'objectif`;
        const _todayWeekStart = _todayEntry
          ? _todayEntry.week_start
          : (() => {
              if (!_todayDate) {
                return "";
              }
              const [year, month, day] = _todayDate.split("-").map(Number);
              const parsed = new Date(year, month - 1, day);
              if (
                Number.isNaN(parsed.getTime()) ||
                parsed.getFullYear() !== year ||
                parsed.getMonth() !== month - 1 ||
                parsed.getDate() !== day
              ) {
                return "";
              }
              const diffToMonday = (parsed.getDay() + 6) % 7;
              parsed.setDate(parsed.getDate() - diffToMonday);
              return `${parsed.getFullYear()}-${String(parsed.getMonth() + 1).padStart(2, "0")}-${String(parsed.getDate()).padStart(2, "0")}`;
            })();
        const _weekEntries = _todayWeekStart ? entries.filter((entry) => entry.week_start === _todayWeekStart) : [];
        const _weekTotalMinutes = _weekEntries.reduce((sum, entry) => sum + Number(entry.worked_minutes || 0), 0);
        const _weekTargetMinutes = _weekEntries.reduce((sum, entry) => sum + Number(entry.target_minutes || 0), 0);
        const _weekOvertimeMinutes = Math.max(0, _weekTotalMinutes - _weekTargetMinutes);
        const _weekBalanceMinutes = _weekTotalMinutes - _weekTargetMinutes;
        const _weekWorkedDays = _weekEntries.reduce((sum, entry) => sum + (entry.is_worked_day ? 1 : 0), 0);
        const _weekTotalHHMM = `${String(Math.floor(Math.max(0, _weekTotalMinutes) / 60)).padStart(2, "0")}:${String(Math.max(0, _weekTotalMinutes) % 60).padStart(2, "0")}`;
        const _weekOvertimeHHMM = `${String(Math.floor(_weekOvertimeMinutes / 60)).padStart(2, "0")}:${String(_weekOvertimeMinutes % 60).padStart(2, "0")}`;
        const _weekBalanceAbs = Math.abs(_weekBalanceMinutes);
        const _weekBalanceHHMM = `${String(Math.floor(_weekBalanceAbs / 60)).padStart(2, "0")}:${String(_weekBalanceAbs % 60).padStart(2, "0")}`;
        const _weekTrendLabel =
          _weekBalanceMinutes > 0
            ? `En avance de ${_weekBalanceHHMM}`
            : _weekBalanceMinutes < 0
              ? `En retrait de ${_weekBalanceHHMM}`
              : "Semaine exactement à l'objectif";
        const _activeClientsCount = clients.length;
        const _monthAverageMinutes = _workedDayCount > 0 ? Math.round(totalMinutes / _workedDayCount) : 0;
        const _monthAverageHHMM = `${String(Math.floor(Math.max(0, _monthAverageMinutes) / 60)).padStart(2, "0")}:${String(Math.max(0, _monthAverageMinutes) % 60).padStart(2, "0")}`;
        const _monthTargetMinutes = entries.reduce((sum, entry) => sum + Number(entry.target_minutes || 0), 0);
        const _monthTargetHHMM = `${String(Math.floor(Math.max(0, _monthTargetMinutes) / 60)).padStart(2, "0")}:${String(Math.max(0, _monthTargetMinutes) % 60).padStart(2, "0")}`;
        const _monthRemainingMinutes = Math.max(0, _monthTargetMinutes - totalMinutes);
        const _monthRemainingHHMM = `${String(Math.floor(_monthRemainingMinutes / 60)).padStart(2, "0")}:${String(_monthRemainingMinutes % 60).padStart(2, "0")}`;
        const _monthProgress = _monthTargetMinutes > 0 ? Math.max(0, Math.min(100, Math.round((totalMinutes / _monthTargetMinutes) * 100))) : 0;
        const _todayRemainingMinutes = Math.max(0, _todayTargetMinutes - _todayWorkedMinutes);
        const _todayRemainingHHMM = `${String(Math.floor(_todayRemainingMinutes / 60)).padStart(2, "0")}:${String(_todayRemainingMinutes % 60).padStart(2, "0")}`;
        const _todayDateLabel = _todayDate
          ? new Date(`${_todayDate}T00:00:00`).toLocaleDateString("fr-FR", {
              weekday: "long",
              day: "2-digit",
              month: "long",
              year: "numeric",
            })
          : "";
        const _heroMessage = authUser ? `Bonjour ${authUser}` : "Bonjour";
        const _progressRingValue = Math.max(0, Math.min(100, _todayProgress));
        const _insightLines = [
          _todayWorkedMinutes >= _todayTargetMinutes ? "Objectif du jour atteint." : `Encore ${_todayRemainingHHMM} pour aujourd'hui.`,
          _weekTrendLabel,
          _monthTargetMinutes > 0
            ? _monthProgress >= 100
              ? "Objectif mensuel atteint."
              : `Encore ${_monthRemainingHHMM} pour l'objectif mensuel.`
            : "Aucun objectif mensuel mesurable sur la période.",
        ];
        const _weekReferenceDate = (() => {
          if (_todayWeekStart) {
            return _todayWeekStart;
          }
          if (_todayDate) {
            const parsed = new Date(`${_todayDate}T00:00:00`);
            const diffToMonday = (parsed.getDay() + 6) % 7;
            parsed.setDate(parsed.getDate() - diffToMonday);
            return `${parsed.getFullYear()}-${String(parsed.getMonth() + 1).padStart(2, "0")}-${String(parsed.getDate()).padStart(2, "0")}`;
          }
          return "";
        })();
        const _weekEntriesByDate = new Map(_weekEntries.map((entry) => [entry.work_date, entry]));
        const _weekPreviewDays = [];
        if (_weekReferenceDate) {
          const _weekStartDateObject = new Date(`${_weekReferenceDate}T00:00:00`);
          for (let _dayOffset = 0; _dayOffset < 7; _dayOffset += 1) {
            const _dayDateObject = new Date(_weekStartDateObject);
            _dayDateObject.setDate(_weekStartDateObject.getDate() + _dayOffset);
            const _isoDay = `${_dayDateObject.getFullYear()}-${String(_dayDateObject.getMonth() + 1).padStart(2, "0")}-${String(_dayDateObject.getDate()).padStart(2, "0")}`;
            const _weekEntry = _weekEntriesByDate.get(_isoDay) || null;
            _weekPreviewDays.push({
              isoDate: _isoDay,
              dayShort: _dayDateObject.toLocaleDateString("fr-FR", { weekday: "short" }),
              dayNumber: _dayDateObject.getDate(),
              isToday: _isoDay === _todayDate,
              stateClass: _weekEntry
                ? _weekEntry.is_worked_day
                  ? _weekEntry.under_target
                    ? "is-partial"
                    : "is-complete"
                  : _weekEntry.day_type === "sick_leave"
                    ? "is-sick"
                    : "is-leave"
                : "is-empty",
              duration: _weekEntry ? _weekEntry.worked_hhmm : "",
              label: _weekEntry ? _weekEntry.day_type_display : "Aucune saisie",
            });
          }
        }
