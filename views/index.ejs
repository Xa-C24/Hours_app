          <div class="mobile-premium-view" data-mobile-view="calendar" data-mobile-title="Calendrier">
      <%
        const _safeFormData = formData && typeof formData === "object" ? formData : {};
        const _safeDefaultEntryFormData =
          defaultEntryFormData && typeof defaultEntryFormData === "object" ? defaultEntryFormData : {};
        const _safeEntries = Array.isArray(entries) ? entries : [];
        const _selectedDate = _safeFormData.date || "";
        const _calendarTodayDate = _safeDefaultEntryFormData.date || "";
        const _calendarEntriesByDate = new Map(_safeEntries.map((entry) => [entry.work_date, entry]));
        const _normalizedSelectedMonth =
          typeof selectedMonth === "string" && /^\d{4}-\d{2}$/.test(selectedMonth)
            ? selectedMonth
            : _calendarTodayDate
              ? String(_calendarTodayDate).slice(0, 7)
              : "";
        const _calendarMonthParts = _normalizedSelectedMonth.split("-").map(Number);
        const _calendarMonthDate =
          _calendarMonthParts.length === 2 && Number.isFinite(_calendarMonthParts[0]) && Number.isFinite(_calendarMonthParts[1])
            ? new Date(_calendarMonthParts[0], (_calendarMonthParts[1] || 1) - 1, 1)
            : new Date();
        const _calendarMonthLabel = _calendarMonthDate.toLocaleDateString("fr-FR", {
          month: "long",
          year: "numeric",
        });
        const _shiftMonth = (monthValue, delta) => {
          const [year, monthNumber] = String(monthValue || "").split("-").map(Number);
          const shifted = new Date(year, (monthNumber || 1) - 1 + delta, 1);
          return `${shifted.getFullYear()}-${String(shifted.getMonth() + 1).padStart(2, "0")}`;
        };
        const _previousMonth = _shiftMonth(_normalizedSelectedMonth, -1);
        const _nextMonth = _shiftMonth(_normalizedSelectedMonth, 1);
        const _calendarDateToIso = (dateObject) =>
          `${dateObject.getFullYear()}-${String(dateObject.getMonth() + 1).padStart(2, "0")}-${String(dateObject.getDate()).padStart(2, "0")}`;
        const _formatCalendarDuration = (hhmmValue) => {
          if (typeof hhmmValue !== "string" || !/^\d{2}:\d{2}$/.test(hhmmValue)) {
            return "";
          }
          const [hoursValue, minutesValue] = hhmmValue.split(":");
          return `${Number(hoursValue)} h ${minutesValue}`;
        };
        const _coerceDate = (value, fallbackDate) => {
          const parsed = value instanceof Date ? new Date(value.getTime()) : new Date(value);
          return Number.isNaN(parsed.getTime()) ? new Date(fallbackDate.getTime()) : parsed;
        };
        const _calendarStartSource = _coerceDate(_payPeriodStartDate, _calendarMonthDate);
        const _calendarEndSource = _coerceDate(_payPeriodEndDate, _calendarMonthDate);
        const _calendarStart = new Date(
          _calendarStartSource.getFullYear(),
          _calendarStartSource.getMonth(),
          _calendarStartSource.getDate()
        );
        const _calendarEnd = new Date(
          _calendarEndSource.getFullYear(),
          _calendarEndSource.getMonth(),
          _calendarEndSource.getDate()
        );
        const _calendarGridStart = new Date(_calendarStart);
        _calendarGridStart.setDate(_calendarGridStart.getDate() - ((_calendarGridStart.getDay() + 6) % 7));
        const _calendarGridEnd = new Date(_calendarEnd);
        _calendarGridEnd.setDate(_calendarGridEnd.getDate() + ((6 - ((_calendarGridEnd.getDay() + 6) % 7) + 7) % 7));
        const _calendarWeeks = [];
        const _calendarLegend = [
          { emoji: "🟢", label: "Journée complète", tone: "complete" },
          { emoji: "🟡", label: "Journée partielle", tone: "partial" },
          { emoji: "🔴", label: "Journée oubliée", tone: "missing" },
          { emoji: "⚪", label: "Aucune saisie", tone: "empty" },
          { emoji: "⚫", label: "Week-end", tone: "weekend" },
          { emoji: "🔵", label: "Congé / RTT", tone: "leave" },
          { emoji: "🟣", label: "Maladie", tone: "sick" },
        ];
        for (let _weekCursor = new Date(_calendarGridStart); _weekCursor <= _calendarGridEnd; ) {
          const _weekDays = [];
          for (let _dayIndex = 0; _dayIndex < 7; _dayIndex += 1) {
            const _currentDate = new Date(_weekCursor);
            const _isoDate = _calendarDateToIso(_currentDate);
            const _entry = _calendarEntriesByDate.get(_isoDate) || null;
            const _isWeekend = _currentDate.getDay() === 0 || _currentDate.getDay() === 6;
            const _isInPeriod = _currentDate >= _calendarStart && _currentDate <= _calendarEnd;
            const _isToday = _isoDate === _calendarTodayDate;
            const _isSelected = _isoDate === _selectedDate;
            const _dayType = _entry ? _entry.day_type : "";
            let _stateTone = "empty";
            let _stateEmoji = "⚪";
            let _stateLabel = "Aucune saisie";
            let _metaLabel = "";
            if (_entry) {
              if (_entry.is_worked_day) {
                _stateTone = _entry.under_target ? "partial" : "complete";
                _stateEmoji = _entry.under_target ? "🟡" : "🟢";
                _stateLabel = _entry.under_target ? "Journée partielle" : "Journée complète";
                _metaLabel = _entry.day_type_display;
              } else if (_dayType === "sick_leave") {
                _stateTone = "sick";
                _stateEmoji = "🟣";
                _stateLabel = "Maladie";
                _metaLabel = _entry.day_type_display;
              } else if (_dayType === "leave" || _dayType === "rtt" || _dayType === "holiday") {
                _stateTone = "leave";
                _stateEmoji = "🔵";
                _stateLabel = _entry.day_type_display;
                _metaLabel = _entry.day_type_display;
              } else {
                _stateTone = "neutral";
                _stateEmoji = "⚪";
                _stateLabel = _entry.day_type_display;
                _metaLabel = _entry.day_type_display;
              }
            } else if (_isInPeriod && _isWeekend) {
              _stateTone = "weekend";
              _stateEmoji = "⚫";
              _stateLabel = "Week-end";
            } else if (_isInPeriod && _calendarTodayDate && _isoDate < _calendarTodayDate) {
              _stateTone = "missing";
              _stateEmoji = "🔴";
              _stateLabel = "Journée oubliée";
            }
            _weekDays.push({
              isoDate: _isoDate,
              dayNumber: _currentDate.getDate(),
              weekdayShort: _currentDate.toLocaleDateString("fr-FR", { weekday: "short" }),
              dateLabel: _currentDate.toLocaleDateString("fr-FR", { day: "2-digit", month: "long" }),
              entry: _entry,
              isWeekend: _isWeekend,
              isInPeriod: _isInPeriod,
              isToday: _isToday,
              isSelected: _isSelected,
              dayType: _dayType,
              durationLabel: _entry && _entry.is_worked_day ? _formatCalendarDuration(_entry.worked_hhmm) : "",
              stateTone: _stateTone,
              stateEmoji: _stateEmoji,
              stateLabel: _stateLabel,
              metaLabel: _metaLabel,
            });
            _weekCursor.setDate(_weekCursor.getDate() + 1);
          }
          _calendarWeeks.push(_weekDays);
        }
      %>
      <section class="card premium-surface premium-surface-wide pay-period-card app-surface app-card" data-pay-period-card>
        <div class="month-header">
          <div class="month-header-copy">
            <h2>Période de paie</h2>
            <% if (_payPeriodLabel) { %>
            <p class="month-period-label"><%= _payPeriodLabel %></p>
            <% } %>
          </div>

          <div class="month-tools">
            <form action="/" method="get" class="month-form">
              <input type="hidden" name="clientId" value="<%= _selectedClientId %>" />
              <div class="month-form-row">
                <label for="month">Choisir un mois</label>
                <div class="month-form-controls">
                  <input id="month" name="month" type="month" required value="<%= selectedMonth %>" />
                  <button type="submit" data-ripple>Afficher</button>
                  <a
                    class="button-link"
                    href="/export.csv?month=<%= encodeURIComponent(selectedMonth) %>&clientId=<%= encodeURIComponent(_selectedClientId) %>"
                    data-ripple
                  >
                    Export CSV
                  </a>
                </div>
              </div>
            </form>
          </div>
          <button
            type="button"
            class="card-toggle"
            data-pay-period-toggle
            data-ripple
            aria-expanded="true"
            aria-controls="payPeriodPanel"
            title="Replier ou ouvrir la période"
          >
            <span class="card-toggle-icon" aria-hidden="true">▾</span>
          </button>
        </div>

        <div id="payPeriodPanel" class="pay-period-panel" data-pay-period-panel>
          <div class="day-filter-bar" data-day-filter-bar>
            <% dayTypeFilters.forEach((filter, index) => { %>
            <button
              type="button"
              class="day-filter-chip <%= index === 0 ? 'is-active' : '' %>"
              data-day-filter="<%= filter.value %>"
              data-ripple
              aria-pressed="<%= index === 0 ? 'true' : 'false' %>"
              title="Période: <%= filter.count %> | Année affichée: <%= filter.yearCount %>"
            >
              <span><%= filter.label %></span>
              <span class="day-filter-counts">
                <span class="day-filter-count" title="Période">
                  <span class="day-filter-count-label" title="Mois" aria-label="Mois">M</span>
                  <span><%= filter.count %></span>
                </span>
                <span class="day-filter-count day-filter-count-year" title="Année affichée">
                  <span class="day-filter-count-label" title="Année" aria-label="Année">A</span>
                  <span><%= filter.yearCount %></span>
                </span>
              </span>
            </button>
            <% }); %>
          </div>

          <div class="calendar-panel">
            <div class="calendar-topbar">
              <div class="calendar-nav" aria-label="Navigation mensuelle">
                <a
                  class="calendar-nav-button"
                  href="/?month=<%= encodeURIComponent(_previousMonth) %>&clientId=<%= encodeURIComponent(_selectedClientId) %>"
                  data-ripple
                  aria-label="Mois précédent"
                >
                  ◀
                </a>
                <div class="calendar-nav-label">
                  <strong><%= _calendarMonthLabel %></strong>
                  <span><%= _payPeriodLabel %></span>
                </div>
                <a
                  class="calendar-nav-button"
                  href="/?month=<%= encodeURIComponent(_nextMonth) %>&clientId=<%= encodeURIComponent(_selectedClientId) %>"
                  data-ripple
                  aria-label="Mois suivant"
                >
                  ▶
                </a>
              </div>

              <div class="calendar-summary-chips" aria-label="Résumé de période">
                <div class="calendar-summary-chip stat-card">
                  <span class="calendar-summary-chip-label stat-label">Jours travaillés</span>
                  <strong class="stat-value"><%= _workedDayCount %></strong>
                </div>
                <div class="calendar-summary-chip stat-card">
                  <span class="calendar-summary-chip-label stat-label">Total</span>
                  <strong class="stat-value"><%= totalHHMM %></strong>
                </div>
                <div class="calendar-summary-chip stat-card">
                  <span class="calendar-summary-chip-label stat-label">Heures sup</span>
                  <strong class="stat-value"><%= totalOvertimeHHMM %></strong>
                </div>
                <div class="calendar-summary-chip stat-card">
                  <span class="calendar-summary-chip-label stat-label">Salaire net</span>
                  <strong class="stat-value"><%= salaryAmountDisplay %></strong>
                </div>
              </div>
            </div>

            <div class="calendar-legend" aria-label="Légende des états">
              <% _calendarLegend.forEach((legendItem) => { %>
              <div class="calendar-legend-item is-<%= legendItem.tone %>">
                <span class="calendar-legend-emoji" aria-hidden="true"><%= legendItem.emoji %></span>
                <span><%= legendItem.label %></span>
              </div>
              <% }); %>
            </div>

            <div class="calendar-board-scroll">
              <div class="calendar-board" data-calendar-board>
                <div class="calendar-weekdays" aria-hidden="true">
                  <span>Lun</span>
                  <span>Mar</span>
                  <span>Mer</span>
                  <span>Jeu</span>
                  <span>Ven</span>
                  <span>Sam</span>
                  <span>Dim</span>
                </div>
                <div class="calendar-grid">
                  <% _calendarWeeks.forEach((calendarWeek) => { %>
                  <% calendarWeek.forEach((calendarDay) => { %>
                  <% if (!calendarDay.isInPeriod) { %>
                  <div class="calendar-day-filler" aria-hidden="true">
                    <span><%= calendarDay.dayNumber %></span>
                  </div>
                  <% } else { %>
                  <button
                    type="button"
                    class="calendar-day-card is-<%= calendarDay.stateTone %><%= calendarDay.isToday ? ' is-today' : '' %><%= calendarDay.isSelected ? ' is-selected' : '' %>"
                    data-calendar-day
                    data-date="<%= calendarDay.isoDate %>"
                    data-day-type="<%= calendarDay.dayType || (calendarDay.isWeekend ? 'weekend' : 'empty') %>"
                    data-state-tone="<%= calendarDay.stateTone %>"
                    aria-pressed="<%= calendarDay.isSelected ? 'true' : 'false' %>"
                    aria-label="<%= `${calendarDay.dateLabel} - ${calendarDay.stateLabel}${calendarDay.durationLabel ? ` - ${calendarDay.durationLabel}` : ''}` %>"
                  >
                    <div class="calendar-day-card-head">
                      <span class="calendar-day-weekday"><%= calendarDay.weekdayShort %></span>
                      <span class="calendar-day-number"><%= calendarDay.dayNumber %></span>
                    </div>
                    <div class="calendar-day-card-body">
                      <strong class="calendar-day-duration"><%= calendarDay.durationLabel || " " %></strong>
                      <span class="calendar-day-state">
                        <span aria-hidden="true"><%= calendarDay.stateEmoji %></span>
                        <span><%= calendarDay.metaLabel || calendarDay.stateLabel %></span>
                      </span>
                    </div>
                    <div class="calendar-day-preview" role="tooltip">
                      <strong><%= calendarDay.dateLabel %></strong>
                      <% if (calendarDay.entry && calendarDay.entry.is_worked_day) { %>
                      <span><%= calendarDay.entry.arrival_time_display %> → <%= calendarDay.entry.departure_time_display %></span>
                      <span>Pause <%= calendarDay.entry.lunch_break_minutes_display %> min</span>
                      <% } else { %>
                      <span><%= calendarDay.stateLabel %></span>
                      <% } %>
                      <% if (selectedClient && selectedClient.company_name) { %>
                      <span><%= selectedClient.company_name %></span>
                      <% } %>
                      <% if (calendarDay.entry && calendarDay.entry.comment_text) { %>
                      <span><%= calendarDay.entry.comment_text %></span>
                      <% } %>
                    </div>
                  </button>
                  <% } %>
                  <% }); %>
                  <% }); %>
                </div>
              </div>
            </div>
            <p class="calendar-empty-filter" data-calendar-empty hidden>Aucune journée ne correspond à ce filtre.</p>

            <div class="calendar-history-shortcut">
              <span>Historique premium disponible dans le panneau Historique.</span>
            </div>
          </div>
        </div>
