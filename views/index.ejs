		      <script>
		      (() => {
		        const bootstrapNode = document.getElementById("hours-settings-bootstrap");
		        const bootstrapData = bootstrapNode ? JSON.parse(bootstrapNode.textContent || "{}") : {};
		        const csrfToken = typeof bootstrapData.csrfToken === "string" ? bootstrapData.csrfToken : "";
		        const emitToast = (detail) => {
		          if (typeof window.showToast === "function") {
		            window.showToast(detail);
		          }
		        };
		        const storeToastFlash = (detail) => {
		          if (typeof window.storeToastFlash === "function") {
		            window.storeToastFlash(detail);
		          }
		        };
		        if (!csrfToken) {
		          return;
		        }

		        document.addEventListener("click", (event) => {
		          const toastLink = event.target instanceof HTMLElement ? event.target.closest("[data-toast-info]") : null;
		          if (!(toastLink instanceof HTMLAnchorElement)) {
		            return;
		          }
		          emitToast({
		            type: "info",
		            message: toastLink.dataset.toastInfo || "Export pret",
		          });
		        });

		        document.addEventListener("submit", (event) => {
		          const toastForm = event.target instanceof HTMLFormElement ? event.target : null;
		          if (!toastForm) {
		            return;
		          }
		          const successMessage = toastForm.dataset.toastSuccess || "";
		          if (successMessage) {
		            storeToastFlash({
		              type: "success",
		              message: successMessage,
		            });
		          }
		        });
	        document.querySelectorAll('form[method="post"]').forEach((form) => {
	          let csrfInput = form.querySelector('input[name="_csrf"]');
	          if (!csrfInput) {
	            csrfInput = document.createElement("input");
	            csrfInput.type = "hidden";
	            csrfInput.name = "_csrf";
	            form.prepend(csrfInput);
	          }
	          csrfInput.value = csrfToken;
	        });
	      })();
	      (() => {
	        const commentField = document.querySelector("[data-comment-target]");
	        const emojiPicker = document.querySelector(".comment-emoji-component");
	        const emojiPickerDetails = document.querySelector(".comment-emoji-picker");

	        if (!commentField || !emojiPicker || !emojiPickerDetails) {
	          return;
	        }

	        const syncEmojiPickerPlacement = () => {
	          const pickerRect = emojiPickerDetails.getBoundingClientRect();
	          const estimatedPopoverHeight = 420;
	          const viewportPadding = 24;
	          const spaceBelow = window.innerHeight - pickerRect.bottom - viewportPadding;
	          const shouldOpenUp = spaceBelow < estimatedPopoverHeight && pickerRect.top > estimatedPopoverHeight * 0.55;
	          emojiPickerDetails.classList.toggle("comment-emoji-picker-up", shouldOpenUp);
	        };

	        const insertEmoji = (emoji) => {
	          const start = commentField.selectionStart ?? commentField.value.length;
          const end = commentField.selectionEnd ?? commentField.value.length;
          const prefix = start > 0 && !/\s$/.test(commentField.value.slice(0, start)) ? " " : "";
          const suffix = end < commentField.value.length && !/^\s/.test(commentField.value.slice(end)) ? " " : "";
          const insertedText = `${prefix}${emoji}${suffix}`;

          commentField.setRangeText(insertedText, start, end, "end");
          commentField.focus();
        };

	        emojiPicker.addEventListener("emoji-click", (event) => {
	          const emoji = event.detail && typeof event.detail.unicode === "string"
	            ? event.detail.unicode
	            : "";
          if (!emoji) {
            return;
          }
	          insertEmoji(emoji);
	          emojiPickerDetails.open = false;
	        });

	        emojiPickerDetails.addEventListener("toggle", () => {
	          if (emojiPickerDetails.open) {
	            syncEmojiPickerPlacement();
	          }
	        });

	        window.addEventListener("resize", () => {
	          if (emojiPickerDetails.open) {
	            syncEmojiPickerPlacement();
	          }
	        });
	      })();

      (() => {
        const dayTypeSelect = document.querySelector("[data-day-type-select]");
        const workedDayFields = [...document.querySelectorAll("[data-worked-day-field]")];
        const workedDayTypes = new Set(["office", "remote"]);

        if (!dayTypeSelect || workedDayFields.length === 0) {
          return;
        }

        const syncWorkedDayFields = () => {
          const isWorkedDay = workedDayTypes.has(dayTypeSelect.value);
          workedDayFields.forEach((field) => {
            field.disabled = !isWorkedDay;
            field.required = isWorkedDay;
          });
        };

        dayTypeSelect.addEventListener("change", syncWorkedDayFields);
        syncWorkedDayFields();
      })();

	      (() => {
	        const entryForm = document.querySelector("[data-entry-form]");
	        const clientIdInput = entryForm ? entryForm.querySelector('input[name="clientId"]') : null;
		        const originalWorkDateInput = entryForm ? entryForm.querySelector('input[name="originalWorkDate"]') : null;
		        const dateInput = entryForm ? entryForm.querySelector("#date") : null;
	        const dayTypeSelect = entryForm ? entryForm.querySelector("#dayType") : null;
	        const arrivalInput = entryForm ? entryForm.querySelector("#arrivalTime") : null;
	        const departureInput = entryForm ? entryForm.querySelector("#departureTime") : null;
	        const lunchInput = entryForm ? entryForm.querySelector("#lunchBreakMinutes") : null;
	        const commentInput = entryForm ? entryForm.querySelector("#commentText") : null;
	        const statusMessage = entryForm ? entryForm.querySelector("[data-entry-load-status]") : null;
          const draftStatus = entryForm ? entryForm.querySelector("[data-entry-draft-status]") : null;
          const stateBadge = entryForm ? entryForm.querySelector("[data-entry-state-badge]") : null;
          const summaryValue = entryForm ? entryForm.querySelector("[data-entry-summary-value]") : null;
          const summaryFeedback = entryForm ? entryForm.querySelector("[data-entry-summary-feedback]") : null;
          const submitButton = entryForm ? entryForm.querySelector("[data-entry-submit-button]") : null;
          const clearDraftButton = entryForm ? entryForm.querySelector("[data-entry-clear-draft]") : null;
	        let activeController = null;

	        if (
	          !entryForm ||
	          !clientIdInput ||
	          !originalWorkDateInput ||
	          !dateInput ||
	          !dayTypeSelect ||
	          !arrivalInput ||
	          !departureInput ||
	          !lunchInput ||
	          !commentInput ||
	          !statusMessage ||
            !draftStatus ||
            !stateBadge ||
	            !summaryValue ||
	            !summaryFeedback ||
	            !submitButton ||
            !clearDraftButton
	        ) {
	          return;
	        }

          const SAVE_FLASH_STORAGE_KEY = "hours_entry_save_flash";
          const DRAFT_SAVE_DEBOUNCE_MS = 280;
		          const SUMMARY_TARGET_MINUTES = 7 * 60;
		          const workedDayTypes = new Set(["office", "remote"]);
          const draftStoreApi = window.hoursEntryDraftStore || null;
          const draftStore =
            draftStoreApi && typeof draftStoreApi.createEntryDraftStore === "function"
              ? draftStoreApi.createEntryDraftStore(window.localStorage)
              : null;
          const createDraftStorageKey =
            draftStoreApi && typeof draftStoreApi.createDraftStorageKey === "function"
              ? draftStoreApi.createDraftStorageKey
              : (clientId, workDate) => `hours:draft:${String(clientId || "").trim()}:${String(workDate || "").trim()}`;
          const isMeaningfulDraft =
            draftStoreApi && typeof draftStoreApi.isMeaningfulDraft === "function"
              ? draftStoreApi.isMeaningfulDraft
              : (payload, baseline) => JSON.stringify(payload || {}) !== JSON.stringify(baseline || {});
          const shouldRestoreDraft =
            draftStoreApi && typeof draftStoreApi.shouldRestoreDraft === "function"
              ? draftStoreApi.shouldRestoreDraft
              : ({ serverEntry, draftEntry }) => !serverEntry && Boolean(draftEntry);
		          const bootstrapNode = document.getElementById("hours-settings-bootstrap");
	          const bootstrapEntries =
	            bootstrapNode
	              ? (() => {
	                  try {
	                    const parsed = JSON.parse(bootstrapNode.textContent || "{}");
	                    return Array.isArray(parsed.entries) ? parsed.entries : [];
	                  } catch (error) {
	                    return [];
	                  }
	                })()
	              : [];
	          const defaultFormValues = {
            workDate: "",
            isExisting: false,
            dayType: entryForm.dataset.defaultDayType || "office",
            arrivalTime: entryForm.dataset.defaultArrivalTime || "",
            departureTime: entryForm.dataset.defaultDepartureTime || "",
            lunchBreakMinutes: entryForm.dataset.defaultLunchBreakMinutes || "",
            commentText: entryForm.dataset.defaultCommentText || "",
          };
	          const entryCache = new Map();
	          const state = {
		            selectedDate: dateInput.value || "",
		            currentEntry: null,
	            statusText: "",
	            statusVariant: "",
              badgeState: "is-empty",
	            lastResolvedKey: "",
              isLoading: false,
	              isDirty: false,
	              isSaving: false,
	              showSavedFlash: false,
                draftStatusText: "",
                restoredDraftKey: "",
		          };
          let draftSaveTimeoutId = 0;

          const formatMinutesToHHMM = (minutes) => {
            const safeMinutes = Math.max(0, Number(minutes) || 0);
            return `${String(Math.floor(safeMinutes / 60)).padStart(2, "0")}:${String(safeMinutes % 60).padStart(2, "0")}`;
          };

          const formatDurationLabel = (minutes) => {
            const safeMinutes = Math.max(0, Number(minutes) || 0);
            const hours = Math.floor(safeMinutes / 60);
            const remainingMinutes = safeMinutes % 60;
            return `${hours} h ${String(remainingMinutes).padStart(2, "0")}`;
          };

	          const cloneEntry = (entry) => ({
	            workDate: entry && entry.workDate ? entry.workDate : state.selectedDate,
	            isExisting: Boolean(entry && entry.isExisting),
	            dayType: entry && entry.dayType ? entry.dayType : defaultFormValues.dayType,
	            arrivalTime: entry && typeof entry.arrivalTime === "string" ? entry.arrivalTime : defaultFormValues.arrivalTime,
            departureTime:
              entry && typeof entry.departureTime === "string" ? entry.departureTime : defaultFormValues.departureTime,
            lunchBreakMinutes:
              entry && typeof entry.lunchBreakMinutes === "string"
                ? entry.lunchBreakMinutes
                : String(
	                    entry && typeof entry.lunchBreakMinutes === "number"
	                      ? entry.lunchBreakMinutes
	                      : defaultFormValues.lunchBreakMinutes
	                  ),
	            commentText: entry && typeof entry.commentText === "string" ? entry.commentText : defaultFormValues.commentText,
	          });

          const entriesMatch = (leftEntry, rightEntry) => {
            const left = cloneEntry(leftEntry);
            const right = cloneEntry(rightEntry);
            return (
              left.workDate === right.workDate &&
              left.dayType === right.dayType &&
              left.arrivalTime === right.arrivalTime &&
              left.departureTime === right.departureTime &&
              left.lunchBreakMinutes === right.lunchBreakMinutes &&
              left.commentText === right.commentText &&
              left.isExisting === right.isExisting
            );
          };

          const getDefaultEntryForSelectedDate = () =>
            cloneEntry({
              ...defaultFormValues,
              workDate: state.selectedDate || dateInput.value || "",
            });

          const getBaselineEntry = () =>
            state.currentEntry && state.currentEntry.isExisting
              ? cloneEntry(state.currentEntry)
              : getDefaultEntryForSelectedDate();

          const updateDirtyState = () => {
            state.isDirty = !entriesMatch(readEntryFromForm(), getBaselineEntry());
          };

          const getBadgeConfig = () => {
            if (state.isLoading || state.isSaving) {
              return {
                className: "is-loading",
                text: "🔄 Chargement",
              };
            }

            if (state.isDirty) {
              return {
                className: "is-dirty",
                text: "🟠 Modifications non enregistrées",
              };
            }

	            if (state.currentEntry && state.currentEntry.isExisting) {
	              return {
	                className: "is-success",
	                text: "Journée enregistrée",
	              };
	            }

	            return {
	              className: "is-empty",
	              text: "Nouvelle journée",
	            };
	          };

	          const renderBadge = () => {
            const badge = getBadgeConfig();
            stateBadge.textContent = badge.text;
            stateBadge.classList.remove("is-success", "is-empty", "is-dirty", "is-loading");
            stateBadge.classList.add(badge.className);
	          };

          const renderDraftStatus = () => {
            draftStatus.textContent = state.draftStatusText || "";
            draftStatus.hidden = !state.draftStatusText;
          };

		          const renderStatus = () => {
	            statusMessage.textContent = state.statusText || "";
	            statusMessage.hidden = !state.statusText;
	            statusMessage.classList.remove("is-success", "is-empty", "is-dirty", "is-loading");
	            if (state.statusVariant) {
	              statusMessage.classList.add(state.statusVariant);
	            }
	          };

          const renderSummary = () => {
            const currentEntry = readEntryFromForm();
            const isWorkedDay = workedDayTypes.has(currentEntry.dayType);

            if (!isWorkedDay) {
              summaryValue.textContent = "00:00";
              summaryFeedback.textContent = "Journée sans objectif horaire";
              return;
            }

            if (!currentEntry.arrivalTime || !currentEntry.departureTime) {
              summaryValue.textContent = "--:--";
              summaryFeedback.textContent = "Renseignez les horaires pour voir le temps prevu";
              return;
            }

            const arrivalParts = currentEntry.arrivalTime.split(":").map(Number);
            const departureParts = currentEntry.departureTime.split(":").map(Number);
            if (arrivalParts.length !== 2 || departureParts.length !== 2) {
              summaryValue.textContent = "--:--";
              summaryFeedback.textContent = "Renseignez les horaires pour voir le temps prevu";
              return;
            }

            const arrivalMinutes = arrivalParts[0] * 60 + arrivalParts[1];
            const departureMinutes = departureParts[0] * 60 + departureParts[1];
            const breakMinutes = Math.max(0, Number(currentEntry.lunchBreakMinutes) || 0);
            const plannedMinutes = Math.max(0, departureMinutes - arrivalMinutes - breakMinutes);

            summaryValue.textContent = formatMinutesToHHMM(plannedMinutes);
            if (departureMinutes <= arrivalMinutes) {
              summaryFeedback.textContent = "Verifiez l'ordre arrivee / depart";
              return;
            }

            if (plannedMinutes >= SUMMARY_TARGET_MINUTES) {
              summaryFeedback.textContent = "Objectif atteint";
              return;
            }

            summaryFeedback.textContent = `Il reste ${formatDurationLabel(SUMMARY_TARGET_MINUTES - plannedMinutes)}`;
          };

          const updateSubmitButton = (label, disabled) => {
            submitButton.textContent = label;
            submitButton.disabled = Boolean(disabled);
            submitButton.classList.toggle("is-saving", Boolean(disabled));
          };

	          const autosizeComment = () => {
            commentInput.style.height = "auto";
            const minHeight = 72;
            commentInput.style.height = `${Math.max(minHeight, commentInput.scrollHeight)}px`;
	          };

	          const setDraftStatus = (message) => {
	            state.draftStatusText = message || "";
	            renderDraftStatus();
	          };

          const emitDraftChange = () => {
            window.dispatchEvent(new CustomEvent("hours:drafts-changed"));
          };

	          const getCurrentDraftKey = () => createDraftStorageKey(clientIdInput.value, dateInput.value);

          const readDraftPayload = () => ({
            clientId: clientIdInput.value || "",
            workDate: dateInput.value || "",
            dayType: dayTypeSelect.value || defaultFormValues.dayType,
            arrivalTime: arrivalInput.value || defaultFormValues.arrivalTime,
            departureTime: departureInput.value || defaultFormValues.departureTime,
            lunchBreakMinutes: lunchInput.value || String(defaultFormValues.lunchBreakMinutes),
            commentText: commentInput.value || "",
          });

          const updateDraftUi = () => {
            if (!draftStore) {
              clearDraftButton.hidden = true;
              return;
            }
            const currentKey = getCurrentDraftKey();
            const hasDraft = Boolean(clientIdInput.value && dateInput.value && draftStore.get(clientIdInput.value, dateInput.value));
            clearDraftButton.hidden = !hasDraft;
            if (!hasDraft && state.restoredDraftKey === currentKey) {
              state.restoredDraftKey = "";
            }
          };

          const clearDraftFor = (clientId, workDate, { statusText = "" } = {}) => {
            if (!draftStore || !clientId || !workDate) {
              return;
            }
	            draftStore.remove(clientId, workDate);
	            if (state.restoredDraftKey === createDraftStorageKey(clientId, workDate)) {
	              state.restoredDraftKey = "";
	            }
            if (statusText) {
              setDraftStatus(statusText);
	            }
	            updateDraftUi();
              emitDraftChange();
	          };

          const persistDraftNow = () => {
            if (!draftStore) {
              return;
            }
            const draftPayload = readDraftPayload();
            if (!draftPayload.clientId || !draftPayload.workDate) {
              clearDraftButton.hidden = true;
              return;
            }
            const baselineEntry = getBaselineEntry();
            const baselineDraft = {
              clientId: draftPayload.clientId,
              workDate: draftPayload.workDate,
              dayType: baselineEntry.dayType,
              arrivalTime: baselineEntry.arrivalTime,
              departureTime: baselineEntry.departureTime,
              lunchBreakMinutes: baselineEntry.lunchBreakMinutes,
              commentText: baselineEntry.commentText,
            };
            if (!isMeaningfulDraft(draftPayload, baselineDraft)) {
              clearDraftFor(draftPayload.clientId, draftPayload.workDate);
              return;
            }
	            draftStore.set(draftPayload);
	            setDraftStatus("Brouillon sauvegarde");
	            updateDraftUi();
              emitDraftChange();
	          };

          const scheduleDraftSave = () => {
            if (draftSaveTimeoutId) {
              window.clearTimeout(draftSaveTimeoutId);
            }
            draftSaveTimeoutId = window.setTimeout(() => {
              persistDraftNow();
            }, DRAFT_SAVE_DEBOUNCE_MS);
          };

          const restoreDraftIfNeeded = () => {
            if (!draftStore) {
              return false;
            }
            const clientId = clientIdInput.value || "";
            const workDate = dateInput.value || "";
            if (!clientId || !workDate) {
              updateDraftUi();
              return false;
            }
            const draftEntry = draftStore.get(clientId, workDate);
            if (!shouldRestoreDraft({ serverEntry: state.currentEntry && state.currentEntry.isExisting ? state.currentEntry : null, draftEntry })) {
              updateDraftUi();
              return false;
            }
            state.currentEntry = {
              ...cloneEntry(draftEntry),
              isExisting: false,
            };
            state.restoredDraftKey = createDraftStorageKey(clientId, workDate);
            renderEntry();
            state.statusText = "Brouillon local restaure";
            state.statusVariant = "is-dirty";
            renderStatus();
            setDraftStatus("Brouillon sauvegarde");
            updateDraftUi();
            return true;
          };

		          const renderEntry = () => {
	            const entry = state.currentEntry ? cloneEntry(state.currentEntry) : cloneEntry(defaultFormValues);
	            originalWorkDateInput.value =
	              state.currentEntry && state.currentEntry.isExisting && state.currentEntry.workDate
	                ? state.currentEntry.workDate
                : "";
            dayTypeSelect.value = entry.dayType;
	            arrivalInput.value = entry.arrivalTime;
	            departureInput.value = entry.departureTime;
	            lunchInput.value = entry.lunchBreakMinutes;
	            commentInput.value = entry.commentText;
	            dayTypeSelect.dispatchEvent(new Event("change", { bubbles: true }));
	              autosizeComment();
	              updateDirtyState();
	              renderSummary();
