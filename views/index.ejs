		          }

		          const shouldAdvance =
		            state.lockedAxis === "x" &&
		            Math.abs(state.deltaX) >= 64 &&
		            Math.abs(state.deltaX) > Math.abs(state.deltaY) * 1.2;
		          if (shouldAdvance) {
		            const direction = state.deltaX < 0 ? 1 : -1;
		            setIndex(state.index + direction, { animate: true, persist: true });
		          } else {
		            setIndex(state.index, { animate: true, persist: false });
	          }
	          resetTouchState();
	        };

		        const syncForViewport = () => {
		          if (!mobileQuery.matches) {
		            track.style.transform = "";
		            track.style.transitionDuration = "";
		            shell.style.height = "";
		            syncActiveState();
		            if (activeViewObserver) {
		              activeViewObserver.disconnect();
		            }
		            return;
		          }
		          setIndex(readSavedIndex(), { animate: false, persist: false });
		        };

	        navButtons.forEach((button) => {
	          button.addEventListener("click", () => {
	            handleTargetSelection(button.dataset.targetView || "");
	          });
	        });

	        dots.forEach((dot) => {
	          dot.addEventListener("click", () => {
	            handleTargetSelection(dot.dataset.targetView || "");
	          });
	        });

	        track.addEventListener("touchstart", handleTouchStart, { passive: true });
	        track.addEventListener("touchmove", handleTouchMove, { passive: false });
	        track.addEventListener("touchend", handleTouchEnd);
	        track.addEventListener("touchcancel", handleTouchEnd);
	        window.addEventListener("resize", syncForViewport);
	        if (typeof mobileQuery.addEventListener === "function") {
	          mobileQuery.addEventListener("change", syncForViewport);
	        } else if (typeof mobileQuery.addListener === "function") {
	          mobileQuery.addListener(syncForViewport);
	        }

		        syncForViewport();
		      })();

		      (() => {
		        const workspace = document.querySelector("[data-settings-workspace]");
		        const openButtons = Array.from(document.querySelectorAll("[data-open-settings-workspace]"));
		        const closeButtons = Array.from(document.querySelectorAll("[data-close-settings-workspace]"));
		        const navButtons = Array.from(document.querySelectorAll("[data-settings-nav-item]"));
		        const sections = Array.from(document.querySelectorAll("[data-settings-section]"));
		        const helpSearchInputs = Array.from(document.querySelectorAll("[data-settings-help-search]"));
		        const helpItems = Array.from(document.querySelectorAll("[data-settings-help-item]"));
		        const commandPalette = document.querySelector("[data-command-palette]");
		        const commandPaletteInput = document.querySelector("[data-command-palette-input]");
		        const commandPaletteItems = Array.from(document.querySelectorAll("[data-command-item]"));
		        const commandPaletteCloseButtons = Array.from(document.querySelectorAll("[data-close-command-palette]"));
		        const mobileSettingsButton = document.querySelector('[data-mobile-nav-button][data-target-view="settings"]');
		        const mobileQuery = window.matchMedia("(max-width: 1050px)");

		        if (!workspace || navButtons.length === 0 || sections.length === 0) {
		          return;
		        }

		        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		        const detailMenus = Array.from(document.querySelectorAll("details.user-menu"));

		        const scrollBehavior = () => (prefersReducedMotion.matches ? "auto" : "smooth");

		        const syncNavState = (targetKey) => {
		          navButtons.forEach((button) => {
		            const isActive = button.dataset.settingsTarget === targetKey;
		            button.classList.toggle("is-active", isActive);
		            button.setAttribute("aria-pressed", String(isActive));
		          });
		        };

		        const revealWorkspace = () => {
		          workspace.hidden = false;
		          workspace.classList.add("is-open");
		        };

		        const closeWorkspace = () => {
		          workspace.hidden = true;
		          workspace.classList.remove("is-open");
		        };

		        const focusSection = (targetKey) => {
		          const matchingSections = sections.filter((item) => item.dataset.settingsSection === targetKey);
		          const section = mobileQuery.matches
		            ? matchingSections.find((item) => item.closest('[data-mobile-view="settings"]')) || matchingSections[0] || sections[0]
		            : matchingSections.find((item) => item.closest("[data-settings-workspace]")) || matchingSections[0] || sections[0];
		          if (!section) {
		            return;
		          }
		          syncNavState(section.dataset.settingsSection || "");
		          section.scrollIntoView({ behavior: scrollBehavior(), block: "start" });
		        };

		        const openWorkspace = (targetKey = "profile") => {
		          if (mobileQuery.matches && mobileSettingsButton) {
		            mobileSettingsButton.click();
		            window.setTimeout(() => {
		              focusSection(targetKey);
		            }, 140);
		            return;
		          }
		          revealWorkspace();
		          window.setTimeout(() => {
		            workspace.scrollIntoView({ behavior: scrollBehavior(), block: "start" });
		            focusSection(targetKey);
		          }, 20);
		        };

		        const closeCommandPalette = () => {
		          if (!commandPalette) {
		            return;
		          }
		          commandPalette.hidden = true;
		          document.body.classList.remove("has-command-palette");
		        };

		        const filterCommandPalette = () => {
		          if (!commandPaletteInput) {
		            return;
		          }
		          const query = (commandPaletteInput.value || "").trim().toLowerCase();
		          commandPaletteItems.forEach((item) => {
		            const searchText = item.dataset.searchText || "";
		            item.hidden = Boolean(query) && !searchText.includes(query);
		          });
		        };

		        const openCommandPalette = () => {
		          if (!commandPalette) {
		            return;
		          }
		          commandPalette.hidden = false;
		          document.body.classList.add("has-command-palette");
		          window.setTimeout(() => {
		            if (commandPaletteInput) {
		              commandPaletteInput.focus();
		              commandPaletteInput.select();
		            }
		          }, 20);
		          window.dispatchEvent(new CustomEvent("app:command-palette-open"));
		        };

		        const applyHelpSearch = (query) => {
		          const normalized = (query || "").trim().toLowerCase();
		          helpItems.forEach((item) => {
		            const text = item.dataset.searchText || "";
		            item.hidden = Boolean(normalized) && !text.includes(normalized);
		          });
		        };

		        openButtons.forEach((button) => {
		          button.addEventListener("click", () => {
		            detailMenus.forEach((menu) => {
		              menu.open = false;
		            });
		            openWorkspace(button.dataset.settingsTarget || "profile");
		          });
		        });

		        closeButtons.forEach((button) => {
		          button.addEventListener("click", closeWorkspace);
		        });

		        navButtons.forEach((button) => {
		          button.addEventListener("click", () => {
		            focusSection(button.dataset.settingsTarget || "profile");
		          });
		        });

		        helpSearchInputs.forEach((input) => {
		          input.addEventListener("input", () => {
		            applyHelpSearch(input.value || "");
		          });
		        });

		        document.querySelectorAll("[data-open-command-palette]").forEach((button) => {
		          button.addEventListener("click", () => {
		            detailMenus.forEach((menu) => {
		              menu.open = false;
		            });
		            openCommandPalette();
		          });
		        });

		        commandPaletteCloseButtons.forEach((button) => {
		          button.addEventListener("click", closeCommandPalette);
		        });

		        if (commandPaletteInput) {
		          commandPaletteInput.addEventListener("input", filterCommandPalette);
		        }

		        commandPaletteItems.forEach((item) => {
		          item.addEventListener("click", () => {
		            closeCommandPalette();
		            openWorkspace(item.dataset.targetSection || "profile");
		          });
		        });

		        document.addEventListener("keydown", (event) => {
		          if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
		            event.preventDefault();
		            openCommandPalette();
		            return;
		          }
		          if (event.key === "Escape") {
		            if (commandPalette && !commandPalette.hidden) {
		              closeCommandPalette();
		              return;
		            }
		          }
		        });

		        window.addEventListener("app:open-command-palette", openCommandPalette);
		        window.dispatchEvent(new CustomEvent("app:command-palette-ready"));
		      })();

		      (() => {
		        const modal = document.querySelector("[data-client-modal]");
        const openButtons = [...document.querySelectorAll("[data-open-client-modal]")];
        const closeButtons = [...document.querySelectorAll("[data-close-client-modal]")];
        const firstInput = modal ? modal.querySelector("#clientCompanyName") : null;

        if (!modal) {
          return;
        }

        const openModal = () => {
          modal.hidden = false;
          document.body.style.overflow = "hidden";
          window.setTimeout(() => {
            firstInput && firstInput.focus();
          }, 0);
        };

        const closeModal = () => {
          modal.hidden = true;
          document.body.style.overflow = "";
        };

        openButtons.forEach((button) => {
          button.addEventListener("click", openModal);
        });

        closeButtons.forEach((button) => {
          button.addEventListener("click", closeModal);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !modal.hidden) {
            closeModal();
          }
        });

        if (!modal.hidden) {
          document.body.style.overflow = "hidden";
          firstInput && firstInput.focus();
        }
      })();

	      (() => {
	        const modal = document.querySelector("[data-client-info-modal]");
        const openButtons = [...document.querySelectorAll("[data-open-client-info-modal]")];
        const closeButtons = [...document.querySelectorAll("[data-close-client-info-modal]")];

        if (!modal) {
          return;
        }

        const openModal = () => {
          modal.hidden = false;
          document.body.style.overflow = "hidden";
        };

        const closeModal = () => {
          modal.hidden = true;
          document.body.style.overflow = "";
        };

        openButtons.forEach((button) => {
          if (!button.disabled) {
            button.addEventListener("click", openModal);
          }
        });

        closeButtons.forEach((button) => {
          button.addEventListener("click", closeModal);
        });

	        document.addEventListener("keydown", (event) => {
	          if (event.key === "Escape" && !modal.hidden) {
	            closeModal();
	          }
	        });
	      })();

	      (() => {
	        function readImageAsDataUrl(file) {
	          return new Promise((resolve, reject) => {
	            const reader = new FileReader();
	            reader.onload = () => resolve(typeof reader.result === "string" ? reader.result : "");
	            reader.onerror = () => reject(reader.error || new Error("read_failed"));
	            reader.readAsDataURL(file);
	          });
	        }

	        function syncClientLogoField(field) {
	          const form = field.closest("form");
	          const hiddenInput = form ? form.querySelector("[data-client-logo-value]") : null;
	          const preview = field.querySelector("[data-client-logo-preview]");
	          const clearButton = field.querySelector("[data-client-logo-clear]");
	          const companyInput = form ? form.querySelector('input[name="company_name"]') : null;
	          if (!(hiddenInput instanceof HTMLInputElement) || !(preview instanceof HTMLElement)) {
	            return;
	          }
	          const value = hiddenInput.value || "";
	          const fallback = companyInput instanceof HTMLInputElement && companyInput.value.trim()
	            ? companyInput.value.trim().slice(0, 1).toUpperCase()
	            : "S";
	          if (value) {
	            preview.classList.add("has-image");
	            preview.innerHTML = `<img src="${value}" alt="Logo société">`;
	            if (clearButton instanceof HTMLElement) {
	              clearButton.hidden = false;
	            }
	            return;
	          }
	          preview.classList.remove("has-image");
	          preview.innerHTML = `<span>${fallback}</span>`;
	          if (clearButton instanceof HTMLElement) {
	            clearButton.hidden = true;
	          }
	        }

	        document.querySelectorAll("[data-client-logo-field]").forEach((field) => {
	          const trigger = field.querySelector("[data-client-logo-trigger]");
	          const upload = field.querySelector("[data-client-logo-upload]");
	          const form = field.closest("form");
	          const hiddenInput = form ? form.querySelector("[data-client-logo-value]") : null;
	          const clearButton = field.querySelector("[data-client-logo-clear]");
	          const companyInput = form ? form.querySelector('input[name="company_name"]') : null;

	          syncClientLogoField(field);

	          if (trigger instanceof HTMLElement && upload instanceof HTMLInputElement) {
	            trigger.addEventListener("click", () => {
	              upload.click();
	            });
	            upload.addEventListener("change", async () => {
	              const file = upload.files && upload.files[0] ? upload.files[0] : null;
	              if (!file || !(hiddenInput instanceof HTMLInputElement)) {
	                return;
	              }
	              if (file.size > 1_500_000) {
	                emitToast({
	                  type: "warning",
	                  message: "Image trop lourde. Choisissez un fichier inferieur a 1,5 MB.",
	                });
	                upload.value = "";
	                return;
	              }
	              try {
	                hiddenInput.value = await readImageAsDataUrl(file);
	                syncClientLogoField(field);
	              } catch (error) {
	                console.error(error);
	                emitToast({
	                  type: "error",
	                  message: "Impossible de charger l'image",
	                });
	              } finally {
	                upload.value = "";
	              }
	            });
	          }

	          if (clearButton instanceof HTMLElement && hiddenInput instanceof HTMLInputElement) {
	            clearButton.addEventListener("click", () => {
	              hiddenInput.value = "";
	              syncClientLogoField(field);
	            });
	          }

	          if (companyInput instanceof HTMLInputElement) {
	            companyInput.addEventListener("input", () => {
	              if (hiddenInput instanceof HTMLInputElement && !hiddenInput.value) {
	                syncClientLogoField(field);
	              }
	            });
	          }
	        });
	      })();

	      (() => {
	        const modal = document.querySelector("[data-confirm-replace-modal]");
        const closeButtons = [...document.querySelectorAll("[data-close-confirm-replace-modal]")];
        const confirmButton = document.querySelector("[data-confirm-replace-submit]");
        const entryForm = document.querySelector("[data-entry-form]");
        const confirmReplaceInput = document.querySelector("[data-confirm-replace-input]");
        const firstField = entryForm ? entryForm.querySelector("#date") : null;

        if (!modal || !entryForm || !confirmReplaceInput) {
          return;
        }

        const openModal = () => {
          modal.hidden = false;
          document.body.style.overflow = "hidden";
          window.setTimeout(() => {
            const focusTarget = confirmButton || closeButtons[0];
            if (focusTarget) {
              focusTarget.focus();
            }
          }, 0);
        };

        const closeModal = () => {
          modal.hidden = true;
          document.body.style.overflow = "";
          confirmReplaceInput.value = "";
          if (firstField) {
            firstField.focus();
          }
        };

        closeButtons.forEach((button) => {
          button.addEventListener("click", closeModal);
        });

        if (confirmButton) {
          confirmButton.addEventListener("click", () => {
            confirmReplaceInput.value = "1";
            entryForm.requestSubmit();
          });
        }

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !modal.hidden) {
            closeModal();
          }
        });

        if (!modal.hidden) {
          openModal();
        }
      })();

      (() => {
        const card = document.querySelector("[data-archived-clients-card]");
        const toggleButton = document.querySelector("[data-archived-clients-toggle]");
        const panel = document.querySelector("[data-archived-clients-panel]");
        const searchInput = document.querySelector("[data-archived-client-search]");
        const items = [...document.querySelectorAll("[data-archived-client-item]")];
        const emptyState = document.querySelector("[data-archived-client-empty]");

        if (!card || !toggleButton || !panel) {
          return;
        }

        const setCollapsed = (collapsed) => {
          card.classList.toggle("is-collapsed", collapsed);
          panel.hidden = collapsed;
          toggleButton.setAttribute("aria-expanded", String(!collapsed));
        };

        toggleButton.addEventListener("click", () => {
          setCollapsed(!card.classList.contains("is-collapsed"));
        });

        items.forEach((item) => {
          const history = item.querySelector("[data-archived-history]");
          const historyToggle = item.querySelector("[data-archived-history-toggle]");
          if (!history || !historyToggle) {
            return;
          }
          historyToggle.addEventListener("click", () => {
            const nextVisible = history.hidden;
            history.hidden = !nextVisible;
            historyToggle.setAttribute("aria-expanded", String(nextVisible));
            historyToggle.textContent = nextVisible ? "Masquer historique" : "Voir historique";
          });
        });

        if (searchInput) {
          searchInput.addEventListener("input", () => {
            const query = searchInput.value.trim().toLowerCase();
            let visibleCount = 0;
            items.forEach((item) => {
              const name = item.dataset.clientName || "";
              const visible = !query || name.includes(query);
              item.hidden = !visible;
              if (visible) {
                visibleCount += 1;
              }
            });
            if (emptyState) {
              emptyState.hidden = visibleCount > 0;
            }
          });
        }
      })();

      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
