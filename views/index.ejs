<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f2937" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Hours" />
    <title>Suivi des heures</title>
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <script type="module" src="/vendor/emoji-picker-element/index.js"></script>
    <script>
      (() => {
        const key = "hours_theme";
        const allowed = ["light", "dark", "deep-ocean-blue", "light-blue", "orange-sunset", "forest-green", "light-green"];
        try {
          const theme = localStorage.getItem(key) || "light";
          document.documentElement.setAttribute("data-theme", allowed.includes(theme) ? theme : "light");
        } catch (error) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <main class="container">
      <header class="page-header">
        <h1>Suivi mensuel des heures de travail</h1>
        <div class="header-actions">
          <div class="theme-picker">
            <label for="themeSelectApp">Theme</label>
            <select id="themeSelectApp" data-theme-selector>
              <option value="light">Ivoire</option>
              <option value="dark">Nuit graphite</option>
              <option value="deep-ocean-blue">Bleu minuit</option>
              <option value="light-blue">Brume bleue</option>
              <option value="orange-sunset">Sable cuivre</option>
              <option value="forest-green">Sauge profonde</option>
              <option value="light-green">Celadon</option>
            </select>
          </div>
          <form action="/logout" method="post" class="logout-form">
            <% if (authUser) { %>
            <span class="user-chip"><%= authUser %></span>
            <% } %>
            <button type="submit" class="secondary">Deconnexion</button>
          </form>
        </div>
      </header>

      <div class="header-spacer" aria-hidden="true"></div>

      
      <% if (error) { %>
      <p class="alert"><%= error %></p>
      <% } %>
      <% const _isEditing = typeof isEditing !== "undefined" ? isEditing : false; %>
      <% const _editingWorkDate = typeof editingWorkDate === "string" ? editingWorkDate : ""; %>

      <section class="card entry-card" data-entry-card>
        <div class="entry-card-top">
          <h2><%= _isEditing ? "Modifier une journee" : "Saisir une journée" %></h2>
          <button
            type="button"
            class="card-toggle"
            data-entry-toggle
            aria-expanded="true"
            aria-controls="entryFormPanel"
            title="Replier ou ouvrir la saisie"
          >
            <span class="card-toggle-icon" aria-hidden="true">▾</span>
          </button>
        </div>
        <form action="/entries" method="post" class="entry-form" id="entryFormPanel" data-entry-form>
          <input type="hidden" name="selectedMonth" value="<%= selectedMonth %>" />
          <input type="hidden" name="originalWorkDate" value="<%= formData.originalWorkDate || '' %>" />

          <div class="field">
            <label for="date">Date</label>
            <input id="date" name="date" type="date" required value="<%= formData.date %>" />
          </div>

          <div class="field">
            <label for="dayType">Type de journee</label>
            <select id="dayType" name="dayType" required data-day-type-select>
              <% dayTypeOptions.forEach((option) => { %>
              <option value="<%= option.value %>" <%= formData.dayType === option.value ? "selected" : "" %>>
                <%= option.label %>
              </option>
              <% }); %>
            </select>
          </div>

          <div class="field">
            <label for="arrivalTime">Heure d'arrivee</label>
            <input
              id="arrivalTime"
              name="arrivalTime"
              type="time"
              required
              value="<%= formData.arrivalTime %>"
              data-worked-day-field
            />
          </div>

          <div class="field">
            <label for="departureTime">Heure de depart</label>
            <input
              id="departureTime"
              name="departureTime"
              type="time"
              required
              value="<%= formData.departureTime %>"
              data-worked-day-field
            />
          </div>

          <div class="field">
            <label for="lunchBreakMinutes">Pause dejeuner (minutes)</label>
            <input
              id="lunchBreakMinutes"
              name="lunchBreakMinutes"
              type="number"
              min="0"
              required
              value="<%= formData.lunchBreakMinutes %>"
              data-worked-day-field
            />
          </div>

          <div class="field field-comment">
            <label for="commentText">Commentaire</label>
            <div class="comment-toolbar">
              <details class="comment-emoji-picker">
                <summary class="comment-emoji-summary">
                  <span>🙂</span>
                  <span class="comment-emoji-caret" aria-hidden="true">▾</span>
                </summary>
                <div class="comment-emoji-popover">
                  <emoji-picker class="comment-emoji-component" locale="fr"></emoji-picker>
                </div>
              </details>
            </div>
            <textarea
              id="commentText"
              name="commentText"
              rows="3"
              maxlength="1000"
              placeholder="Ex: reunion client, deplacement, taches importantes..."
              data-comment-target
            ><%= formData.commentText || "" %></textarea>
          </div>

          <div class="form-actions">
            <button type="submit"><%= _isEditing ? "Mettre a jour" : "Enregistrer" %></button>
            <% if (_isEditing) { %>
            <a class="button-link button-neutral" href="/?month=<%= encodeURIComponent(selectedMonth) %>">
              Annuler
            </a>
            <% } %>
          </div>
        </form>
      </section>
<br>
      <div class="between-sections-spacer" aria-hidden="true"></div>

      <section class="card">
        <div class="month-header">
          <div class="month-header-copy">
            <h2>Periode de paie</h2>
            <% if (payPeriodLabel) { %>
            <p class="month-period-label"><%= payPeriodLabel %></p>
            <% } %>
          </div>
          <div class="month-tools">
            <form action="/" method="get" class="month-form">
              <label for="month">Choisir un mois</label>
              <input id="month" name="month" type="month" required value="<%= selectedMonth %>" />
              <button type="submit">Afficher</button>
            </form>
            <a class="button-link" href="/export.csv?month=<%= encodeURIComponent(selectedMonth) %>">
              Export CSV
            </a>
          </div>
        </div>

        <div class="day-filter-bar" data-day-filter-bar>
          <% dayTypeFilters.forEach((filter, index) => { %>
          <button
            type="button"
            class="day-filter-chip <%= index === 0 ? 'is-active' : '' %>"
            data-day-filter="<%= filter.value %>"
            aria-pressed="<%= index === 0 ? 'true' : 'false' %>"
          >
            <span><%= filter.label %></span>
            <span class="day-filter-count"><%= filter.count %></span>
          </button>
          <% }); %>
        </div>

        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Arrivee</th>
                <th>Depart</th>
                <th>Pause (min)</th>
                <th>Heures du jour</th>
                <th class="overtime-col">Heures sup</th>
                <th class="recovered-col">Heures recup</th>
                <th>Etat</th>
                <th class="comment-col">Commentaire</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (displayEntries.length === 0) { %>
              <tr>
                <td colspan="11" class="empty">Aucune journee enregistree pour cette periode.</td>
              </tr>
              <% } %>

              <% displayEntries.forEach((entry) => { %>
              <% if (entry.is_week_total) { %>
              <tr
                class="<%= [entry.week_color_class, 'week-total-row'].filter(Boolean).join(' ') %>"
                data-week-total-row
                data-week-key="<%= entry.week_start || '' %>"
              >
                <td colspan="5">
                  <div class="week-total-main">
                    <div class="week-total-left">
                      <button
                        type="button"
                        class="week-toggle"
                        data-week-toggle
                        aria-expanded="true"
                        title="Replier ou ouvrir la semaine"
                      >
                        <span class="week-toggle-icon" aria-hidden="true">▾</span>
                      </button>
                      <strong>Total semaine</strong>
                    </div>
                    <% if (entry.week_summary_label) { %>
                    <span class="week-meta"><%= entry.week_summary_label %></span>
                    <% } %>
                  </div>
                </td>
                <td><strong><%= entry.week_total_hhmm %></strong></td>
                <td class="overtime-col"><strong><%= entry.week_total_overtime_hhmm %></strong></td>
                <td class="recovered-col"><strong><%= entry.week_total_recovered_hhmm %></strong></td>
                <td colspan="3"></td>
              </tr>
              <% } else { %>
              <tr
                class="<%= [entry.week_color_class, entry.under_target ? 'under-target' : '', _editingWorkDate === entry.work_date ? 'editing-row' : ''].filter(Boolean).join(' ') %>"
                data-day-entry-row
                data-day-type="<%= entry.day_type %>"
                data-week-key="<%= entry.week_start || '' %>"
              >
                <td>
                  <%= entry.work_date_display || (entry.work_date ? new Date(`${entry.work_date}T00:00:00`).toLocaleDateString("fr-FR", { weekday: "long", day: "2-digit", month: "long", year: "numeric" }) : "") %>
                </td>
                <td><%= entry.day_type_display %></td>
                <td><%= entry.arrival_time_display %></td>
                <td><%= entry.departure_time_display %></td>
                <td><%= entry.lunch_break_minutes_display %></td>
                <td><%= entry.worked_hhmm %></td>
                <td class="overtime-col"><%= entry.overtime_hhmm %></td>
                <td class="recovered-col"><%= entry.recovered_minutes > 0 ? entry.recovered_hhmm : "" %></td>
                <td>
                  <span class="status-pill <%= !entry.is_worked_day ? 'neutral' : entry.recovered_minutes > 0 ? 'recovered' : entry.under_target ? 'under' : 'ok' %>">
                    <%= !entry.is_worked_day ? entry.day_type_display : entry.recovered_minutes > 0 ? `Recup ${entry.recovered_hhmm}` : entry.under_target ? 'Moins de 7h' : 'OK' %>
                  </span>
                </td>
                <td class="comment-cell"><%= entry.comment_text || "" %></td>
                <td>
                  <div class="row-actions">
                    <a
                      class="button-link secondary-link"
                      href="/entries/<%= entry.work_date %>/edit?month=<%= encodeURIComponent(selectedMonth) %>"
                    >
                      Modifier
                    </a>
                    <form
                      action="/entries/<%= entry.work_date %>/delete"
                      method="post"
                      onsubmit="return confirm('Supprimer cette journee ?');"
                    >
                      <input type="hidden" name="selectedMonth" value="<%= selectedMonth %>" />
                      <button type="submit" class="danger">Supprimer</button>
                    </form>
                  </div>
                </td>
              </tr>
              <% } %>
              <% }); %>
              <% if (displayEntries.length > 0) { %>
              <tr data-filter-empty-row hidden>
                <td colspan="11" class="empty">Aucune journee pour ce filtre.</td>
              </tr>
              <% } %>
            </tbody>
            <tfoot>
              <tr class="monthly-total-row">
                <th colspan="3"></th>
                <th colspan="2" class="summary-pair-cell">
                  <span class="summary-pair-label">Jours travaillés</span>
                  <span class="summary-pair-value"><%= workedDayCount %></span>
                </th>
                <th>Total periode</th>
                <th><%= totalHHMM %></th>
                <th class="overtime-col"><%= totalOvertimeHHMM %></th>
                <th class="recovered-col"><%= totalRecoveredHHMM %></th>
                <th class="salary-label-cell">
                  <details class="salary-editor" <%= showSalaryEditor ? "open" : "" %>>
                    <summary class="salary-editor-summary">
                      <span>Salaire net</span>
                      <span class="salary-editor-trigger" aria-hidden="true">+</span>
                    </summary>
                    <form action="/pay-period-salary" method="post" class="salary-editor-panel">
                      <input type="hidden" name="selectedMonth" value="<%= selectedMonth %>" />
                      <label for="salaryAmountInline">Montant</label>
                      <input
                        id="salaryAmountInline"
                        name="salaryAmount"
                        type="number"
                        min="0"
                        step="0.01"
                        inputmode="decimal"
                        value="<%= salaryAmountInput %>"
                        placeholder="Ex: 4850.00$"
                      />
                      <button type="submit">OK</button>
                    </form>
                  </details>
                </th>
                <th class="salary-value-cell"><%= salaryAmountDisplay %></th>
              </tr>
            </tfoot>
          </table>
        </div>
      </section>
    </main>
    <script src="/theme.js"></script>
    <script>
      (() => {
        const commentField = document.querySelector("[data-comment-target]");
        const emojiPicker = document.querySelector(".comment-emoji-component");
        const emojiPickerDetails = document.querySelector(".comment-emoji-picker");

        if (!commentField || !emojiPicker || !emojiPickerDetails) {
          return;
        }

        const insertEmoji = (emoji) => {
          const start = commentField.selectionStart ?? commentField.value.length;
          const end = commentField.selectionEnd ?? commentField.value.length;
          const prefix = start > 0 && !/\s$/.test(commentField.value.slice(0, start)) ? " " : "";
          const suffix = end < commentField.value.length && !/^\s/.test(commentField.value.slice(end)) ? " " : "";
          const insertedText = `${prefix}${emoji}${suffix}`;

          commentField.setRangeText(insertedText, start, end, "end");
          commentField.focus();
        };

        emojiPicker.addEventListener("emoji-click", (event) => {
          const emoji = event.detail && typeof event.detail.unicode === "string"
            ? event.detail.unicode
            : "";
          if (!emoji) {
            return;
          }
          insertEmoji(emoji);
          emojiPickerDetails.open = false;
        });
      })();

      (() => {
        const dayTypeSelect = document.querySelector("[data-day-type-select]");
        const workedDayFields = [...document.querySelectorAll("[data-worked-day-field]")];
        const workedDayTypes = new Set(["office", "remote"]);

        if (!dayTypeSelect || workedDayFields.length === 0) {
          return;
        }

        const syncWorkedDayFields = () => {
          const isWorkedDay = workedDayTypes.has(dayTypeSelect.value);
          workedDayFields.forEach((field) => {
            field.disabled = !isWorkedDay;
            field.required = isWorkedDay;
          });
        };

        dayTypeSelect.addEventListener("change", syncWorkedDayFields);
        syncWorkedDayFields();
      })();

      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
