              <% displayEntries.forEach((entry) => { %>
              <% if (entry.is_week_total) { %>
              <tr
                class="<%= [entry.week_color_class, 'week-total-row'].filter(Boolean).join(' ') %>"
                data-week-total-row
                data-week-key="<%= entry.week_start || '' %>"
              >
                <td colspan="5">
                  <div class="week-total-main">
                    <div class="week-total-left">
                      <button
                        type="button"
                        class="week-toggle"
                        data-week-toggle
                        data-ripple
                        aria-expanded="true"
                        title="Replier ou ouvrir la semaine"
                      >
                        <span class="week-toggle-icon" aria-hidden="true">▾</span>
                      </button>
                      <strong>Total semaine</strong>
                    </div>
                    <% if (entry.week_summary_label) { %>
                    <span class="week-meta"><%= entry.week_summary_label %></span>
                    <% } %>
                  </div>
                </td>
                <td><strong><%= entry.week_total_hhmm %></strong></td>
                <td class="overtime-col"><strong><%= entry.week_total_overtime_hhmm %></strong></td>
                <td class="recovered-col"><strong><%= entry.week_total_recovered_hhmm %></strong></td>
                <td colspan="3"></td>
              </tr>
