<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f2937" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Hours" />
    <title>Mot de passe oublié</title>
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <script>
      (() => {
        const key = "hours_theme";
        const allowed = ["light", "dark", "deep-ocean-blue", "light-blue", "orange-sunset", "forest-green", "light-green"];
        try {
          const theme = localStorage.getItem(key) || "light";
          document.documentElement.setAttribute("data-theme", allowed.includes(theme) ? theme : "light");
        } catch (error) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <main class="login-page">
      <div class="login-shell">
        <div class="login-topbar">
          <div class="theme-picker">
            <label for="themeSelectForgotPassword">Theme</label>
            <select id="themeSelectForgotPassword" data-theme-selector>
              <option value="light">Ivoire</option>
              <option value="dark">Nuit graphite</option>
              <option value="deep-ocean-blue">Bleu minuit</option>
              <option value="light-blue">Brume bleue</option>
              <option value="orange-sunset">Sable cuivre</option>
              <option value="forest-green">Sauge profonde</option>
              <option value="light-green">Celadon</option>
            </select>
          </div>
        </div>
        <section class="login-card login-card-header-centered">
          <h1>Mot de passe oublié</h1>
          <p class="login-subtitle">Utilisez votre code de récupération pour definir un nouveau mot de passe.</p>

          <% if (success) { %>
          <p class="alert alert-success"><%= success %></p>
          <% } %>

          <% if (error) { %>
          <p class="alert"><%= error %></p>
          <% } %>

          <% if (recoveryCode) { %>
          <div class="alert alert-success recovery-code-box">
            <strong>Nouveau code de recuperation :</strong>
            <div class="recovery-code-value"><%= recoveryCode %></div>
            <div>Conservez-le. L'ancien code n'est plus valable.</div>
          </div>
          <% } %>

          <form action="/forgot-password" method="post" class="login-form">
            <div class="field">
              <label for="username">Nom utilisateur</label>
              <input
                id="username"
                name="username"
                type="text"
                autocomplete="username"
                required
                value="<%= formData.username || '' %>"
              />
            </div>

            <div class="field">
              <label for="recoveryCode">Code de recuperation</label>
              <input
                id="recoveryCode"
                name="recoveryCode"
                type="text"
                autocomplete="off"
                required
              />
            </div>

            <div class="field">
              <label for="newPassword">Nouveau mot de passe</label>
              <input
                id="newPassword"
                name="newPassword"
                type="password"
                autocomplete="new-password"
                required
              />
            </div>

            <div class="field">
              <label for="confirmPassword">Confirmer le nouveau mot de passe</label>
              <input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                autocomplete="new-password"
                required
              />
            </div>

            <button type="submit">Reinitialiser le mot de passe</button>
          </form>

          <p class="auth-switch">
            Retour a la <a href="/login<%= formData.username ? `?username=${encodeURIComponent(formData.username)}` : '' %>">connexion</a>
          </p>
          <p class="auth-switch auth-switch-compact auth-switch-centered">
            <a href="mailto:xperienceweb@protonmail.com">Contacter support technique</a>
          </p>
        </section>
      </div>
    </main>
    <script src="/theme.js"></script>
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
