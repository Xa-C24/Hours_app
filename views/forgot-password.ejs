<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f2937" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Hours" />
    <title>Mot de passe oublie</title>
    <link rel="icon" type="image/svg+xml" href="/ApH32x32.png" />
    <link rel="manifest" href="/manifest.json" />
    <script>
      (() => {
        const themeKey = "hours_theme";
        const styleKey = "hours_style";
        const allowedThemes = ["light", "dark", "deep-ocean-blue", "light-blue", "orange-sunset", "forest-green", "light-green", "robot"];
        const allowedStyles = ["premium", "robot", "retro"];
        try {
          const storedTheme = localStorage.getItem(themeKey) || "light";
          const theme = storedTheme === "futuristic-robot" ? "robot" : storedTheme;
          const storedStyle = localStorage.getItem(styleKey) || "";
          const style = allowedStyles.includes(storedStyle) ? storedStyle : theme === "robot" ? "robot" : "premium";
          document.documentElement.setAttribute("data-theme", allowedThemes.includes(theme) ? theme : "light");
          document.documentElement.setAttribute("data-style", style);
        } catch (error) {
          document.documentElement.setAttribute("data-theme", "light");
          document.documentElement.setAttribute("data-style", "premium");
        }
      })();
    </script>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="auth-premium-page">
    <main class="login-page">
      <div class="login-shell">
        <div class="login-topbar">
          <div class="theme-picker">
            <label for="themeSelectForgotPassword">Theme</label>
            <select id="themeSelectForgotPassword" data-theme-selector>
              <option value="light">Ivoire</option>
              <option value="dark">Nuit graphite</option>
              <option value="deep-ocean-blue">Bleu minuit</option>
              <option value="light-blue">Brume bleue</option>
              <option value="orange-sunset">Sable cuivre</option>
              <option value="forest-green">Sauge profonde</option>
              <option value="light-green">Celadon</option>
            </select>
          </div>
          <div class="theme-picker">
            <label for="styleSelectForgotPassword">Style</label>
            <select id="styleSelectForgotPassword" data-style-selector>
              <option value="premium">Premium</option>
              <option value="robot">Robot</option>
              <option value="retro">SEGA</option>
            </select>
          </div>
        </div>
        <section class="login-card login-card-header-centered login-card-premium">
          
          <h1>Mot de passe oublie</h1>
          <p class="login-subtitle">Utilisez votre code de recuperation pour definir un nouveau mot de passe en toute securite.</p>

          <% if (success) { %>
          <p class="alert alert-success"><%= success %></p>
          <% } %>

          <% if (error) { %>
          <p class="alert"><%= error %></p>
          <% } %>

          <% if (recoveryCode) { %>
          <div class="alert alert-success recovery-code-box">
            <strong>Nouveau code de recuperation :</strong>
            <div class="recovery-code-value"><%= recoveryCode %></div>
            <div>Conservez-le. L'ancien code n'est plus valable.</div>
          </div>
          <% } %>

	          <form action="/forgot-password" method="post" class="login-form">
	            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
	            <div class="field">
              <label for="username">Nom utilisateur</label>
              <input
                id="username"
                name="username"
                type="text"
                autocomplete="username"
                required
                value="<%= formData.username || '' %>"
              />
            </div>

            <div class="field">
              <label for="recoveryCode">Code de recuperation</label>
              <input
                id="recoveryCode"
                name="recoveryCode"
                type="text"
                autocomplete="off"
                required
              />
            </div>

            <div class="field">
              <label for="newPassword">Nouveau mot de passe</label>
              <div class="password-field">
                <input
	                  id="newPassword"
	                  name="newPassword"
	                  type="password"
	                  autocomplete="new-password"
	                  minlength="10"
	                  required
	                  data-password-input
                />
                <button type="button" class="password-toggle secondary" data-password-toggle aria-label="Afficher le mot de passe" title="Afficher le mot de passe">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.8" />
                  </svg>
                </button>
              </div>
            </div>

            <div class="field">
              <label for="confirmPassword">Confirmer le nouveau mot de passe</label>
              <div class="password-field">
                <input
	                  id="confirmPassword"
	                  name="confirmPassword"
	                  type="password"
	                  autocomplete="new-password"
	                  minlength="10"
	                  required
	                  data-password-input
                />
                <button type="button" class="password-toggle secondary" data-password-toggle aria-label="Afficher le mot de passe" title="Afficher le mot de passe">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.8" />
                  </svg>
                </button>
              </div>
            </div>

            <button type="submit" data-ripple>Reinitialiser le mot de passe</button>
          </form>

          <p class="auth-switch">
            Retour a la <a href="/login<%= formData.username ? `?username=${encodeURIComponent(formData.username)}` : '' %>" data-ripple>connexion</a>
          </p>
          <p class="auth-switch auth-switch-compact auth-switch-centered">
            <a href="mailto:xperienceweb@protonmail.com" data-ripple>Contacter support technique</a>
          </p>
        </section>
      </div>
    </main>
    <script src="/theme.js"></script>
    <script>
      (() => {
        const passwordFields = [...document.querySelectorAll(".password-field")];
        passwordFields.forEach((field) => {
          const input = field.querySelector("[data-password-input]");
          const toggle = field.querySelector("[data-password-toggle]");
          if (!input || !toggle) {
            return;
          }
          toggle.addEventListener("click", () => {
            const showPassword = input.type === "password";
            input.type = showPassword ? "text" : "password";
            toggle.setAttribute("aria-label", showPassword ? "Masquer le mot de passe" : "Afficher le mot de passe");
            toggle.title = showPassword ? "Masquer le mot de passe" : "Afficher le mot de passe";
          });
        });
      })();

      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
