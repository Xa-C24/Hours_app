<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f2937" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Hours" />
    <title>Connexion</title>
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <script>
      (() => {
        const themeKey = "hours_theme";
        const styleKey = "hours_style";
        const allowedThemes = ["light", "dark", "deep-ocean-blue", "light-blue", "orange-sunset", "forest-green", "light-green", "robot"];
        const allowedStyles = ["premium", "robot", "retro"];
        try {
          const storedTheme = localStorage.getItem(themeKey) || "light";
          const theme = storedTheme === "futuristic-robot" ? "robot" : storedTheme;
          const storedStyle = localStorage.getItem(styleKey) || "";
          const style = allowedStyles.includes(storedStyle) ? storedStyle : theme === "robot" ? "robot" : "premium";
          document.documentElement.setAttribute("data-theme", allowedThemes.includes(theme) ? theme : "light");
          document.documentElement.setAttribute("data-style", style);
        } catch (error) {
          document.documentElement.setAttribute("data-theme", "light");
          document.documentElement.setAttribute("data-style", "premium");
        }
      })();
    </script>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="auth-premium-page">
    <main class="login-page">
      <div class="login-shell">
        <div class="login-topbar">
          <div class="theme-picker">
            <label for="themeSelectLogin">Theme</label>
            <select id="themeSelectLogin" data-theme-selector>
              <option value="light">Ivoire</option>
              <option value="dark">Nuit graphite</option>
              <option value="deep-ocean-blue">Bleu minuit</option>
              <option value="light-blue">Brume bleue</option>
              <option value="orange-sunset">Sable cuivre</option>
              <option value="forest-green">Sauge profonde</option>
              <option value="light-green">Celadon</option>
            </select>
          </div>
          <div class="theme-picker">
            <label for="styleSelectLogin">Style</label>
            <select id="styleSelectLogin" data-style-selector>
              <option value="premium">Premium</option>
              <option value="robot">Robot</option>
              <option value="retro">SEGA</option>
            </select>
          </div>
        </div>
        <section class="login-card login-card-header-centered login-card-premium">
          
          <h1>Connexion</h1>
          <p class="login-subtitle">Accedez a votre espace de suivi des heures.</p>

          <% if (success) { %>
          <p class="alert alert-success"><%= success %></p>
          <% } %>

          <% if (error) { %>
          <p class="alert"><%= error %></p>
          <% } %>

          <form action="/login" method="post" class="login-form">
            <div class="field">
              <label for="username">Nom utilisateur</label>
              <input
                id="username"
                name="username"
                type="text"
                autocomplete="username"
                required
                value="<%= formData.username || '' %>"
              />
            </div>

            <div class="field">
              <label for="password">Mot de passe</label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
              />
            </div>

            <button type="submit" data-ripple>Se connecter</button>
          </form>

          <p class="auth-switch">
            Pas de compte ? <a href="/register" data-ripple>Creer un compte</a>
          </p>
          <p class="auth-switch auth-switch-compact">
            Mot de passe oublie ? <a href="/forgot-password<%= formData.username ? `?username=${encodeURIComponent(formData.username)}` : '' %>" data-ripple>Utiliser un code de recuperation</a>
          </p>
          <p class="auth-switch auth-switch-compact auth-switch-centered">
            <a href="mailto:xperienceweb@protonmail.com" data-ripple>Contacter support technique</a>
          </p>
        </section>
      </div>
    </main>
    <script src="/theme.js"></script>
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
